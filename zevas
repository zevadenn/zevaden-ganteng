    -- SLIDER
    local function slider(parent, label, cfgKey, mn, mx, default, cb)
        local r = row(parent, ROW_SLIDER)
        local value = cfg[cfgKey] ~= nil and cfg[cfgKey] or default or mn
        local lbl = Instance.new("TextLabel", r)
        lbl.Size, lbl.BackgroundTransparency, lbl.Text, lbl.TextColor3, lbl.Font, lbl.TextSize =
            UDim2.new(1,-60,0,16), 1, label, TH.Text, FONT, 12
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.ZIndex = 8

        local valLbl = Instance.new("TextLabel", r)
        valLbl.Size, valLbl.Position, valLbl.BackgroundTransparency, valLbl.Text, valLbl.TextColor3, valLbl.Font, valLbl.TextSize =
            UDim2.new(0,60,0,16), UDim2.new(1,-60,0,0), 1, tostring(value), TH.Accent, FONTB, 11
        valLbl.TextXAlignment = Enum.TextXAlignment.Right
        valLbl.ZIndex = 8
        regAccent(valLbl, "TextColor3")

        local track = Instance.new("Frame", r)
        track.Size, track.Position, track.BackgroundColor3, track.BorderSizePixel =
            UDim2.new(1,0,0,4), UDim2.new(0,0,0,30), TH.Off, 0
        track.ZIndex = 8
        round(track, 2)

        local fill = Instance.new("Frame", track)
        fill.Size, fill.BackgroundColor3, fill.BorderSizePixel = UDim2.new((value-mn)/(mx-mn),0,1,0), TH.Accent, 0
        fill.ZIndex = 9
        round(fill, 2); regAccent(fill, "BackgroundColor3")

        local knob = Instance.new("Frame", track)
        knob.Size, knob.AnchorPoint, knob.Position, knob.BackgroundColor3, knob.BorderSizePixel =
            UDim2.new(0,14,0,14), Vector2.new(0.5,0.5), UDim2.new((value-mn)/(mx-mn),0,0.5,0), Color3.new(1,1,1), 0
        knob.ZIndex = 10
        round(knob, 7); stroke(knob, TH.Bg, 2)

        local function redraw(animated)
            local rel = math.clamp((value-mn)/(mx-mn), 0, 1)
            local info = animated and EASE.soft or EASE.fast
            tw(fill, info, {Size = UDim2.new(rel, 0, 1, 0)})
            tw(knob, info, {Position = UDim2.new(rel, 0, 0.5, 0)})
            if tostring(value) ~= valLbl.Text then
                valLbl.Text = tostring(value)
                if animated then
                    valLbl.TextTransparency = 0.5
                    tw(valLbl, EASE.fast, {TextTransparency = 0})
                end
            end
        end

        local dragging = false
        local function apply(i)
            local rel = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            value = math.floor(mn + (mx-mn) * rel); redraw(true); if cb then cb(value) end
        end
        track.InputBegan:Connect(function(i)
            if i.UserInputType == UIT_M1 or i.UserInputType == UIT_TCH then
                dragging = true; apply(i)
                tw(knob, EASE.backSm, {Size = UDim2.new(0, 18, 0, 18)})
            end
        end)
        U.InputChanged:Connect(function(i) if dragging and (i.UserInputType == UIT_MMV or i.UserInputType == UIT_TCH) then apply(i) end end)
        U.InputEnded:Connect(function(i)
            if i.UserInputType == UIT_M1 or i.UserInputType == UIT_TCH then
                dragging = false
                tw(knob, EASE.backSm, {Size = UDim2.new(0, 14, 0, 14)})
            end
        end)
        regRefresh(cfgKey, function() value = cfg[cfgKey]; redraw(false) end)
        regFeature(label, BUILD_PAGE, r)
        return {set = function(v) value = v; redraw(true); cb(v) end, get = function() return value end}
    end

