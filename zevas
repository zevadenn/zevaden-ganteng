local PRIORITY_PARTS = {"Head", "UpperTorso", "HumanoidRootPart", "Torso", "LowerTorso"}
local function getTargetPartForChar(char)
    if not char then return nil end
    if Settings.PartPriority then
        for _, n in ipairs(PRIORITY_PARTS) do
            local p = char:FindFirstChild(n)
            if p then return p end
        end
    end
    local name = getEffectiveTargetPart()
    return char:FindFirstChild(name) or char:FindFirstChild("HumanoidRootPart")
end

local function getClosestTarget()
    local refPoint = getFovReference()
    local cam = workspace.CurrentCamera
    if not cam then return nil end

    if Settings.TargetListEnabled and Settings.TargetOnPlayer and #Settings.TargetOnPlayer > 0 then
        local closestTargetPart, closestTargetDist = nil, math.huge
        for _, targetName in ipairs(Settings.TargetOnPlayer) do
            local targetPlr = Players:FindFirstChild(targetName)
            if targetPlr and isValidTarget(targetPlr) then
                local part = getTargetPartForChar(targetPlr.Character)
                if part then
                    local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - refPoint).Magnitude
                        if screenDist < closestTargetDist then
                            closestTargetPart = part
                            closestTargetDist = screenDist
                        end
                    end
                end
            end
        end
        return closestTargetPart
    end

    local localRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not localRoot then return nil end

    local closest, shortest = nil, math.huge
    if Settings.AimMode == "Distance" then
        for _, plr in ipairs(Players:GetPlayers()) do
            if isValidTarget(plr) then
                local part = getTargetPartForChar(plr.Character)
                if part then
                    local d = (part.Position - localRoot.Position).Magnitude
                    if d < shortest then closest, shortest = part, d end
                end
            end
        end
        return closest
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if isValidTarget(plr) then
            local part = plr.Character:FindFirstChild(getEffectiveTargetPart())
                or plr.Character:FindFirstChild("HumanoidRootPart")
            if part then
                local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
                if onScreen then
                    local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - refPoint).Magnitude
                    if screenDist <= Settings.FOVRadius then
                        local d = (part.Position - localRoot.Position).Magnitude
                        if d < shortest then closest, shortest = part, d end
                    end
                end
            end
        end
    end
    return closest
end

local function getReleaseRadius()
    local mult = Settings.FOVReleaseMult or 2.5
    if not Settings.StickyFOV then mult = 1.05 end
    if Settings.MouseSteer then mult = mult + 0.5 end
    return Settings.FOVRadius * mult
end

local function getClosestTargetWithLock()
    if Settings.Aimbot and lockedTarget and lockedTarget.Parent then
        local ownerPlr
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character == lockedTarget.Parent then ownerPlr = p; break end
        end
        if ownerPlr and isValidTarget(ownerPlr) then
            local sp, onScreen = workspace.CurrentCamera:WorldToViewportPoint(lockedTarget.Position)
            if onScreen then
                local ref = getFovReference()
                local dist = (Vector2.new(sp.X, sp.Y) - ref).Magnitude
                if dist <= getReleaseRadius() then
                    return lockedTarget
                end
            end
        end
        lockedTarget = nil
        smoothedTargetPosition = nil
    end
    local t = getClosestTarget()
    if Settings.Aimbot and t then
        if lockedTarget ~= t then
            smoothedTargetPosition = nil
        end
        lockedTarget = t
    end
    return t
end

-- ═══ SILENT AIM HOOK ═══
local ExpectedArguments = {
    FindPartOnRayWithIgnoreList = { ArgCountRequired = 3, Args = { "Instance", "Ray", "table", "boolean", "boolean" } },
    FindPartOnRayWithWhitelist = { ArgCountRequired = 3, Args = { "Instance", "Ray", "table", "boolean" } },
    FindPartOnRay              = { ArgCountRequired = 2, Args = { "Instance", "Ray", "Instance", "boolean", "boolean" } },
    Raycast                    = { ArgCountRequired = 3, Args = { "Instance", "Vector3", "Vector3", "RaycastParams" } },
}

local function CalculateChance(Percentage)
    Percentage = math.floor(Percentage)
    local chance = math.floor(Random.new().NextNumber(Random.new(), 0, 1) * 100) / 100
    return chance <= Percentage / 100
end

local function ValidateArguments(Args, RayMethod)
    local Matches = 0
    if #Args < RayMethod.ArgCountRequired then return false end
    for Pos, Argument in next, Args do
        if typeof(Argument) == RayMethod.Args[Pos] then Matches = Matches + 1 end
    end
    return Matches >= RayMethod.ArgCountRequired
end

local function getSpreadDirection(Origin, OriginalDirection, HitPart)
    if typeof(HitPart) ~= "Instance" or not HitPart.Parent then return OriginalDirection end
    local OriginalDistance = OriginalDirection.Magnitude
    if OriginalDistance == 0 then OriginalDistance = 1000 end
    local target = HitPart.Position
    if not Settings.NoSpread then
        local ps = HitPart.Size
        target = target + Vector3.new(
            (math.random() - 0.5) * ps.X * 0.7,
            (math.random() - 0.5) * ps.Y * 0.7,
            (math.random() - 0.5) * ps.Z * 0.3
        )
    end
    local dir = target - Origin
    if dir.Magnitude == 0 then return OriginalDirection end
    return dir.Unit * math.max(OriginalDistance, dir.Magnitude)
end

local function getRedirectedDirection(Origin, OriginalDirection)
    if currentTarget and currentTarget.Parent then
        return getSpreadDirection(Origin, OriginalDirection, currentTarget)
    end
    return nil
end

local function isLocalPlayerShooting(Arguments, Method, Origin, OriginalDirection)
    local LocalChar = player.Character
    if not LocalChar then return false end
    local cam = workspace.CurrentCamera
    if not cam then return false end
    local rayLength = OriginalDirection and OriginalDirection.Magnitude or 0
    if Origin and (Origin - cam.CFrame.Position).Magnitude <= 2 then
        if rayLength < 30 then return false end
    end
    local ignoreList = nil
    if Method == "Raycast" then
        local params = Arguments[4]
        if typeof(params) == "RaycastParams" then ignoreList = params.FilterDescendantsInstances end
    elseif Method == "FindPartOnRayWithIgnoreList" then
        if typeof(Arguments[3]) == "table" then ignoreList = Arguments[3] end
    elseif Method == "FindPartOnRay" or Method == "findPartOnRay" then
        if typeof(Arguments[3]) == "table" then ignoreList = Arguments[3]
        elseif typeof(Arguments[4]) == "table" then ignoreList = Arguments[4] end
    end
    if ignoreList then
        for _, inst in next, ignoreList do
            if inst == LocalChar then return true end
        end
    end
    if Origin and (Origin - cam.CFrame.Position).Magnitude <= 2 then return true end
    return false
end

local function tryGetOriginDirection(Method, Arguments)
    if Method == "FindPartOnRayWithIgnoreList" or Method == "FindPartOnRayWithWhitelist"
        or Method == "FindPartOnRay" or Method == "findPartOnRay" then
        local A_Ray = Arguments[2]
        if typeof(A_Ray) == "Ray" then return A_Ray.Origin, A_Ray.Direction end
    elseif Method == "Raycast" then
        local A_Origin = Arguments[2]
        local A_Direction = Arguments[3]
        if typeof(A_Origin) == "Vector3" and typeof(A_Direction) == "Vector3" then
            return A_Origin, A_Direction
        end
    end
    return nil, nil
end

local AutoShootRaycastInProgress = false
local PRISON_LIFE_PLACE = 155615604

local oldNamecall
local mt = getrawmetatable(game)
if mt then
    setreadonly(mt, false)
    oldNamecall = mt.__namecall
    mt.__namecall = newcclosure(function(...)
        local Method = getnamecallmethod()
        local self = ...
        local Arguments = {...}

        if Method ~= "Raycast" and Method ~= "FindPartOnRayWithIgnoreList"
            and Method ~= "FindPartOnRayWithWhitelist" and Method ~= "FindPartOnRay"
            and Method ~= "findPartOnRay" and Method ~= "Play" then
            return oldNamecall(...)
        end

        if Method == "Play" and self.ClassName == "Sound" and not checkcaller() then
            if game.PlaceId == PRISON_LIFE_PLACE and Settings.Enabled and Settings.MuteGunSound then
                local tool = self.Parent and self.Parent.Parent
                local localChar = player.Character
                if localChar and tool and tool.Parent == localChar
                    and tool.ClassName == "Tool"
                    and tool:GetAttribute("ToolType") == "Gun" then
                    local sn = string.lower(self.Name)
                    local isShot = string.find(sn, "shoot", 1, true)
                        or string.find(sn, "fire", 1, true)
                        or string.find(sn, "shot", 1, true)
                    local isReload = string.find(sn, "reload", 1, true)
                        or string.find(sn, "mag", 1, true)
                        or string.find(sn, "equip", 1, true)
                    if isShot and not isReload then
                        local soundClone = self:Clone()
                        soundClone.Parent = workspace.CurrentCamera
                        soundClone.Playing = true
                        task.delay(5, soundClone.Destroy, soundClone)
                        return
                    end
                end
            end
        end

        if self == workspace and not checkcaller() then
            local Origin, Direction = tryGetOriginDirection(Method, Arguments)
            if Origin and Direction and isLocalPlayerShooting(Arguments, Method, Origin, Direction) then
                if Settings.Enabled and Settings.Method:lower() == Method:lower() and not AutoShootRaycastInProgress then
                    local chance = CalculateChance(Settings.HitChance)
                    if chance == true then
                        if Method == "FindPartOnRayWithIgnoreList" and ValidateArguments(Arguments, ExpectedArguments.FindPartOnRayWithIgnoreList) then
                            local NewDir = getRedirectedDirection(Origin, Direction)
                            if NewDir then Arguments[2] = Ray.new(Origin, NewDir) end
                        elseif Method == "FindPartOnRayWithWhitelist" and ValidateArguments(Arguments, ExpectedArguments.FindPartOnRayWithWhitelist) then
                            local NewDir = getRedirectedDirection(Origin, Direction)
                            if NewDir then Arguments[2] = Ray.new(Origin, NewDir) end
                        elseif (Method == "FindPartOnRay" or Method == "findPartOnRay") and ValidateArguments(Arguments, ExpectedArguments.FindPartOnRay) then
                            local NewDir = getRedirectedDirection(Origin, Direction)
                            if NewDir then Arguments[2] = Ray.new(Origin, NewDir) end
                        elseif Method == "Raycast" and ValidateArguments(Arguments, ExpectedArguments.Raycast) then
                            local NewDir = getRedirectedDirection(Origin, Direction)
                            if NewDir then Arguments[3] = NewDir end
                        end
                    end
                end
                local rets = table.pack(oldNamecall(unpack(Arguments)))
                return table.unpack(rets, 1, rets.n)
            end
        end
        return oldNamecall(...)
    end)
    setreadonly(mt, true)
end

