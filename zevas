    local function performSearch(q)
        q = q:lower():gsub("^%s+",""):gsub("%s+$","")
        if q == "" then return end
        local best, bs = nil, 0
        for _, f in ipairs(FEATURE_INDEX) do
            local s = 0
            if f.name == q then s = 1000
            elseif f.name:sub(1,#q) == q then s = 500 + (100 - math.min(100, #f.name - #q))
            elseif f.name:find(q, 1, true) then s = 100 + (50 - math.min(50, #f.name - #q)) end
            if s > bs then bs = s; best = f end
        end
        if not best then return end
        setTab(best.tab)
        task.spawn(function()
            task.wait(0.06)
            local pg = pages[best.tab]
            if pg and best.target and best.target.Parent then
                pcall(function()
                    local absY = (best.target.AbsolutePosition.Y - pg.AbsolutePosition.Y) + pg.CanvasPosition.Y
                    local scrollY = math.max(0, absY - pg.AbsoluteSize.Y / 3)
                    tw(pg, 0.25, {CanvasPosition = Vector2.new(0, scrollY)})
                end)
                local hi = Instance.new("Frame", best.target)
                hi.Size, hi.BackgroundColor3, hi.BackgroundTransparency, hi.BorderSizePixel, hi.ZIndex =
                    UDim2.new(1,0,1,0), TH.Accent, 0.35, 0, 20
                round(hi, 8)
                task.wait(0.6); tw(hi, 0.5, {BackgroundTransparency = 1}); task.wait(0.6); hi:Destroy()
            end
        end)
    end

