        local b = Instance.new("TextButton", r)
        b.Size, b.Position, b.BackgroundColor3, b.Text, b.TextColor3, b.Font, b.TextSize =
            UDim2.new(0.5,-10,1,0), UDim2.new(0.5,0,0,0), TH.Panel2, keyName(getKey()), TH.Accent, FONTB, 11
        b.AutoButtonColor, b.BorderSizePixel = false, 0
        b.ClipsDescendants = true
        b.ZIndex = 8
        round(b, 8); stroke(b, TH.LineHi, 1, 0.4); regAccent(b, "TextColor3")

        local bs = b:FindFirstChildOfClass("UIStroke")
        local listening = false
        local pulseThread = nil
        local function stopPulse()
            if pulseThread then pcall(function() task.cancel(pulseThread) end); pulseThread = nil end
            if bs then pcall(function() tw(bs, EASE.fast, {Color = TH.LineHi, Transparency = 0.4}) end) end
        end

        b.MouseButton1Click:Connect(function()
            if listening then return end
            listening = true
            b.Text = "press a key..."
            if bs then
                bs.Color = TH.Accent; bs.Transparency = 0
                pulseThread = task.spawn(function()
                    while listening and bs and bs.Parent do
                        tw(bs, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Transparency = 0.7})
                        task.wait(0.5)
                        tw(bs, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Transparency = 0})
                        task.wait(0.5)
                    end
                end)
            end
            task.wait(0.15)
            local conn
            conn = U.InputBegan:Connect(function(input, gpe)
                if gpe then return end
                if not listening then if conn then conn:Disconnect() end; return end
                local isKey = input.UserInputType == UI_KBD
                local isL = input.UserInputType == UIT_M1
                local isR = input.UserInputType == UI_M2
                local isM = input.UserInputType == UI_M3
                if isKey or isL or isR or isM then
                    if conn then conn:Disconnect() end
                    listening = false
                    stopPulse()
                    local key
                    if isKey then key = input.KeyCode
                    elseif isL then key = UIT_M1
                    elseif isR then key = UI_M2
                    else key = UI_M3 end
                    if key == Enum.KeyCode.Escape then b.Text = keyName(getKey())
                    elseif key == Enum.KeyCode.Backspace then setKey(nil); b.Text = "None"
                    else setKey(key); b.Text = keyName(key) end
                end
            end)
            task.delay(5, function()
                if listening then
                    if conn then conn:Disconnect() end
                    listening = false
                    stopPulse()
                    b.Text = keyName(getKey())
                end
            end)
        end)
        regRefresh(cfgKey, function() b.Text = keyName(cfg[cfgKey]) end)
        regFeature(label, BUILD_PAGE, r)
        return b
    end

