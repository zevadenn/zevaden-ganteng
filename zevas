    -- KO / DEAD DETECTION
    local function isKOorDead(pl)
        if not pl or pl == p then return true end
        local ch = pl.Character; if not ch then return true end
        local hum = ch:FindFirstChildOfClass("Humanoid"); if not hum then return true end
        if hum.Health <= 0 then return true end
        local okS, state = pcall(function() return hum:GetState() end)
        if okS then
            if state == Enum.HumanoidStateType.Dead then return true end
            if state == Enum.HumanoidStateType.Physics then return true end
        end
        if hum.PlatformStand then return true end
        for i = 1, #KO_MARKERS do
            local entry = KO_MARKERS[i]
            local container = ch:FindFirstChild(entry[1])
            if container then
                local target = entry[2] and container:FindFirstChild(entry[2]) or container
                if target then
                    if target:IsA("BoolValue") and target.Value then return true end
                    if target:IsA("NumberValue") and target.Value > 0 then return true end
                    if target:IsA("StringValue") and target.Value ~= "" then return true end
                end
            end
        end
        for i = 1, #KO_ATTRS do
            local attrName = KO_ATTRS[i]
            local okC, val = pcall(function() return ch:GetAttribute(attrName) end)
            if okC and val ~= nil then
                if attrName == "Alive" then
                    if val == false then return true end
                elseif val == true or val == "true" then return true end
            end
            local okP, val2 = pcall(function() return pl:GetAttribute(attrName) end)
            if okP and val2 ~= nil then
                if attrName == "Alive" then
                    if val2 == false then return true end
                elseif val2 == true or val2 == "true" then return true end
            end
        end
        local hrp = ch:FindFirstChild("HumanoidRootPart")
        if hrp then
            local ragdollFolder = hrp:FindFirstChild("RagdollConstraints")
            if ragdollFolder and #ragdollFolder:GetChildren() > 0 then return true end
        end
        return false
    end
