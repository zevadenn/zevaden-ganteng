    activeTab = name
    for n, data in pairs(tabBtns) do
        local on = n == name
        data.btn.BackgroundTransparency = on and 0.15 or 0.55
        data.btn.BackgroundColor3 = on and TH.Surface2 or TH.Surface
        data.btn.TextColor3 = on and TH.Accent or TH.Text
        data.btn.Font = on and FONTB or FONT
        data.under.Size = on and UDim2.new(0.6, 0, 0, 2) or UDim2.new(0, 0, 0, 2)
    end
    for n, p in pairs(panels) do
        p.Visible = (n == name)
    end
end
for name, data in pairs(tabBtns) do
    data.btn.Active = true
    data.btn.Activated:Connect(function() setTab(name) end)
end
setTab("Combat")

local function setMenu(v)
    menuOpen = v
    root.Visible = v
    drop.Visible = v
end
