    rem(d.D); rem(d.T); rem(d.LT); rem(d.Name); rem(d.Weapon); rem(d.HeadDot); rem(d.Hat)
    if d.Arrow then for _, ln in ipairs(d.Arrow) do rem(ln) end end
    for _, l in pairs(d.L) do rem(l) end
    for _, l in pairs(d.C_Lines) do rem(l) end
    drawings[pl] = nil
