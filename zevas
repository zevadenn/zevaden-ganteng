    local function setTab(name)
        if activeTab == name then return end
        local prev = activeTab
        activeTab = name

        for n, data in pairs(tabButtons) do
            local on = (n == name)
            tw(data.btn, EASE.soft, {BackgroundTransparency = on and 0.5 or 1})
            tw(data.label, EASE.soft, {TextColor3 = on and TH.Text or TH.TextDim})
            tw(data.bar, EASE.med, {
                Size = on and UDim2.new(0, ICON_W, 0, tabH - 14) or UDim2.new(0, ICON_W, 0, 0)
            })
            local targetX = on and (data.baseX + 8) or data.baseX
            tw(data.label, EASE.med, {Position = UDim2.new(0, targetX, 0.5, 0)})
        end
        if prev and pages[prev] then
            local old = pages[prev]
            task.delay(0.05, function() if old and old.Parent then old.Visible = false end end)
        end
        if pages[name] then
            local pg = pages[name]
            pg.Visible = true
            local children = {}
            for _, ch in ipairs(pg:GetChildren()) do
                if ch:IsA("Frame") then table.insert(children, ch) end
            end
            for i, ch in ipairs(children) do
                ch.Position = UDim2.new(0, 16, 0, 0)
                local targetBG = ch:GetAttribute("zevaBG") or 0.55
                ch:SetAttribute("zevaBG", targetBG)
                ch.BackgroundTransparency = 1
                task.delay((i - 1) * 0.03, function()
                    if ch and ch.Parent then
                        tw(ch, EASE.pageIn, {Position = UDim2.new(0, 0, 0, 0)})
                        tw(ch, EASE.pageIn, {BackgroundTransparency = targetBG})
                    end
                end)
            end
        end
    end

