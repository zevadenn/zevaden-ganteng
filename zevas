    local function CalcPred(pl, targetPart)
        if not targetPart then return nil end
        local vel = getAvgVel(pl)
        local pos = targetPart.Position
        if not cfg.AutoPred then return pos + vel * cfg.Pred end
        local dist = (pos - c.CFrame.Position).Magnitude
        local leadTime = (dist / 500) * cfg.PredScale
        return pos + vel * leadTime
    end

    local function pushCham(pl)
        local existing = hitChams[pl]
        if existing then existing.expiresAt = tick() + 2; return end
        local sq = Drawing.new("Square")
        sq.Thickness, sq.Filled, sq.Color, sq.Transparency, sq.Visible =
            2, true, Color3.fromRGB(0, 255, 140), 0.65, true
        hitChams[pl] = { sq = sq, expiresAt = tick() + 2 }
    end

    local function updateChams()
        local now = tick()
        for pl, data in pairs(hitChams) do
            if now > data.expiresAt then
                pcall(function() data.sq:Remove() end); hitChams[pl] = nil
            else
                local ch = pl.Character
                if ch then
                    local hrp = ch:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local ps, on = c:WorldToViewportPoint(hrp.Position)
                        local tS = c:WorldToViewportPoint(hrp.Position + Vector3.new(0, 2.5, 0))
                        local bS = c:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                        local h = math.abs(bS.Y - tS.Y); local w = h / 1.6
                        data.sq.Size = Vector2.new(w, h)
                        data.sq.Position = Vector2.new(ps.X - w/2, tS.Y)
                        data.sq.Visible = on and ps.Z > 0
                    end
                end
            end
        end
    end

    function buildCrosshair()
        for _, o in ipairs(crosshairParts) do pcall(function() o:Remove() end) end
        crosshairParts = {}
        if not cfg.Crosshair then return end
        local vs = c.ViewportSize
        local cx, cy = vs.X/2, vs.Y/2
        local col = cfg.CrosshairColor
        local th = cfg.CrosshairThickness
        local s = cfg.CrosshairSize
        local gap = cfg.CrosshairGap

        local function line(x1,y1,x2,y2)
            local l
            pcall(function() l = Drawing.new("Line") end)
            if not l then return end
            l.From = Vector2.new(cx+x1, cy+y1)
            l.To   = Vector2.new(cx+x2, cy+y2)
            l.Color = col; l.Thickness = th; l.Transparency = 1; l.Visible = true
            table.insert(crosshairParts, l)
        end
        local function dot(r)
            local cD
            pcall(function() cD = Drawing.new("Circle") end)
            if not cD then return end
            cD.Position = Vector2.new(cx, cy); cD.Radius = r
            cD.NumSides = 32; cD.Filled = true; cD.Color = col
            cD.Transparency = 1; cD.Visible = true
            table.insert(crosshairParts, cD)
        end
        local function ring(r)
            local cD
            pcall(function() cD = Drawing.new("Circle") end)
            if not cD then return end
            cD.Position = Vector2.new(cx, cy); cD.Radius = r
            cD.NumSides = 48; cD.Filled = false; cD.Color = col
            cD.Thickness = th; cD.Transparency = 1; cD.Visible = true
            table.insert(crosshairParts, cD)
        end

        if cfg.CrosshairStyle == "Cross" then
            line(-s, 0, -gap, 0); line(gap, 0, s, 0)
            line(0, -s, 0, -gap); line(0, gap, 0, s)
        elseif cfg.CrosshairStyle == "Dot" then
            dot(math.max(1, th))
        elseif cfg.CrosshairStyle == "Circle" then
            ring(s)
        elseif cfg.CrosshairStyle == "T" then
            line(-s, 0, s, 0); line(0, 0, 0, s)
        end
    end
    buildCrosshair()

    local function scoreTarget(pl, part, camPos, screenCenter)
        if cfg.AimPriority == "Closest" then
            return (part.Position - camPos).Magnitude
        elseif cfg.AimPriority == "LowestHP" then
            local hum = pl.Character and pl.Character:FindFirstChildOfClass("Humanoid")
            return hum and hum.Health or math.huge
        elseif cfg.AimPriority == "Visible" then
            local sp = c:WorldToViewportPoint(part.Position)
            local visPenalty = vis(part) and 0 or 100000
            return visPenalty + (Vector2.new(sp.X, sp.Y) - screenCenter).Magnitude
        end
        local sp = c:WorldToViewportPoint(part.Position)
        return (Vector2.new(sp.X, sp.Y) - screenCenter).Magnitude
    end

