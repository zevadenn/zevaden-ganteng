local CONFIG_FILE = "silent_aim_config.json"

local function loadConfig(defaults)
    if isfile and isfile(CONFIG_FILE) then
        local success, decoded = pcall(function()
            return HttpService:JSONDecode(readfile(CONFIG_FILE))
        end)
        if success and type(decoded) == "table" then
            for k, v in pairs(decoded) do
                if defaults[k] ~= nil then
                    if typeof(defaults[k]) == "Color3" and type(v) == "table" and v.R and v.G and v.B then
                        defaults[k] = Color3.new(v.R, v.G, v.B)
                    else
                        defaults[k] = v
                    end
                end
            end
        end
    end
    return defaults
end

local function saveConfig(settings)
    if writefile then
        local copy = {}
        for k, v in pairs(settings) do
            if string.sub(k, 1, 1) ~= "_" then
                if typeof(v) == "Color3" then
                    copy[k] = {R = v.R, G = v.G, B = v.B}
                else
                    copy[k] = v
                end
            end
        end
        pcall(function()
            writefile(CONFIG_FILE, HttpService:JSONEncode(copy))
        end)
    end
end

