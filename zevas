        glowStroke.Parent = glow
        regAccent(glowStroke, "Color")

        local knob = Instance.new("Frame", track)
        knob.Size, knob.AnchorPoint, knob.BackgroundColor3, knob.BorderSizePixel =
            UDim2.new(0,18,0,18), Vector2.new(0.5,0.5),
            state and Color3.new(1,1,1) or TH.TextDim, 0
        knob.Position = UDim2.new(0, state and 30 or 6, 0.5, 0)
        knob.ZIndex = 9
        round(knob, 9)

        local function refresh(animated)
            local info = animated and EASE.back or EASE.fast
            tw(track, EASE.soft, {BackgroundColor3 = state and TH.Accent or TH.Off})
            tw(knob, info, {
                Position = UDim2.new(0, state and 30 or 6, 0.5, 0),
                BackgroundColor3 = state and Color3.new(1,1,1) or TH.TextDim
            })
            tw(glowStroke, EASE.soft, {Transparency = state and 0.55 or 1})
            if animated then
                glowStroke.Transparency = 0
                tw(glowStroke, EASE.med, {Transparency = state and 0.55 or 1})
