    end)
    local caps = {}
    local env = (getgenv and getgenv()) or _G or {}
    for _, fn in ipairs({
        "getrawmetatable", "setreadonly", "hookfunction", "newcclosure",
        "checkcaller", "getnamecallmethod", "getsenv", "getreg",
        "getupvalues", "getgc", "iscclosure", "islclosure",
        "gethwid", "request", "http_request", "writefile", "readfile",
