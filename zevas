    local function performSearch(query)
        query = query:lower():gsub("^%s+", ""):gsub("%s+$", "")
        if query == "" then return end

        local best, bestScore = nil, 0
        for _, feat in ipairs(FEATURE_INDEX) do
            local score = 0
            if feat.name == query then
                score = 1000
            elseif feat.name:sub(1, #query) == query then
                score = 500 + (100 - math.min(100, #feat.name - #query))
            elseif feat.name:find(query, 1, true) then
                score = 100 + (50 - math.min(50, #feat.name - #query))
            end
            if score > bestScore then
                bestScore = score
                best = feat
            end
        end

        if not best then return end
        setTab(best.tab)

        task.spawn(function()
            task.wait(0.06)
            local page = pages[best.tab]
            if page and best.target and best.target.Parent then
                pcall(function()
                    local absY = (best.target.AbsolutePosition.Y - page.AbsolutePosition.Y) + page.CanvasPosition.Y
                    local scrollY = math.max(0, absY - page.AbsoluteSize.Y / 3)
                    tw(page, 0.25, { CanvasPosition = Vector2.new(0, scrollY) })
                end)

                local hi = Instance.new("Frame", best.target)
                hi.Size = UDim2.new(1, 0, 1, 0)
                hi.BackgroundColor3 = TH.Accent
                hi.BackgroundTransparency = 0.35
                hi.BorderSizePixel = 0
                hi.ZIndex = 20
                round(hi, 8)

                task.wait(0.6)
                tw(hi, 0.5, { BackgroundTransparency = 1 })
                task.wait(0.6)
                hi:Destroy()
            end
        end)
    end

