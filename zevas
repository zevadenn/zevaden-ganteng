local function round(o, r)
    local cc = Instance.new("UICorner"); cc.CornerRadius = UDim.new(0, r or 6); cc.Parent = o; return cc
end
local function stroke(o, col, th, trans)
    local s = Instance.new("UIStroke"); s.Color = col or TH.Line; s.Thickness = th or 1; s.Transparency = trans or 0; s.Parent = o; return s
end
local function tw(o, t, props)
    local ti = TweenInfo.new(t or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TS:Create(o, ti, props); tween:Play(); return tween
end

