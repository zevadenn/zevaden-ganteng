        local color = Color3.fromHSV(hue, saturation, value)
        local r = math.floor(color.R * 255 + 0.5)
        local g = math.floor(color.G * 255 + 0.5)
        local b = math.floor(color.B * 255 + 0.5)
        field.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
        marker.Position = UDim2.fromScale(saturation, 1 - value)
        hueMarker.Position = UDim2.fromScale(0, hue)
        sample.BackgroundColor3 = color
        hex.Text = string.format("#%02X%02X%02X", r, g, b)
        setCol(color)
    end

    local draggingSurface = nil
    local function pointAt(position)
        if not draggingSurface then return end
        local offset = Vector2.new(position.X, position.Y) - draggingSurface.AbsolutePosition
        local x = math.clamp(offset.X / math.max(1, draggingSurface.AbsoluteSize.X), 0, 1)
        local y = math.clamp(offset.Y / math.max(1, draggingSurface.AbsoluteSize.Y), 0, 1)
        if draggingSurface == field then
            saturation, value = x, 1 - y
        elseif draggingSurface == hueStrip then
            hue = y
        end
        apply()
    end

