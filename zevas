    local function autoHop()
        if not cfg.WallHop then return end
        local char = p.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not (hrp and hum) then return end

        local now = tick()
        local onGround = hum.FloorMaterial ~= Enum.Material.Air

        if onGround then
            if now - lastJumpFire > 0.03 then
                hum.Jump = true
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
                lastJumpFire = now
            end
            return
        end

        if now - lastHop < 0.06 then return end

        wallHopRay.FilterDescendantsInstances = {char}
        local origin = hrp.Position
        local lv, rv = hrp.CFrame.LookVector, hrp.CFrame.RightVector
        local dirs = {
            lv, -lv, rv, -rv,
            (lv + rv).Unit, (lv - rv).Unit, (-lv + rv).Unit, (-lv - rv).Unit,
        }
        local normal = nil
        for _, d in ipairs(dirs) do
            local r = workspace:Raycast(origin, d * 4.5, wallHopRay)
            if r then normal = r.Normal; break end
        end
        if not normal then return end

        lastHop = now
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
        local push = Instance.new("BodyVelocity")
        push.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        push.Velocity = normal * cfg.WallHopPower + Vector3.new(0, 50, 0)
        push.Parent = hrp
        game:GetService("Debris"):AddItem(push, 0.18)
    end

    local function applyAntiAim()
        local char = p.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local neck = char:FindFirstChild("Neck", true)
        if neck and neck:IsA("Motor6D") then
            neck.C0 = CFrame.new(0, 1, 0)
                * CFrame.Angles(-math.pi/2 + math.rad(cfg.AntiAimPitch), math.pi, 0)
        end

        local yaw
        if cfg.AntiAimMode == "Static" then
            yaw = cfg.AntiAimYaw
        elseif cfg.AntiAimMode == "Jitter" then
            yaw = cfg.AntiAimYaw + math.random(-45, 45)
        elseif cfg.AntiAimMode == "Spin" then
            aaYawAccum = (aaYawAccum + cfg.AntiAimSpinSpeed) % 360
            yaw = aaYawAccum
        else
            yaw = cfg.AntiAimYaw
        end

        local look = hrp.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, 1) end
        flat = flat.Unit
        local newLook = CFrame.Angles(0, math.rad(yaw), 0) * flat
        hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + newLook)
    end

    local function restoreAntiAim()
        aaYawAccum = 0
        local char = p.Character
        if char then
            local neck = char:FindFirstChild("Neck", true)
            if neck and neck:IsA("Motor6D") then
                neck.C0 = CFrame.new(0, 1, 0) * CFrame.Angles(-math.pi/2, math.pi, 0)
            end
        end
    end

    local function curveAlpha(t)
        t = math.clamp(t, 0, 1)
        if cfg.SmoothCurve == "Exponential" then
            return t * t
        elseif cfg.SmoothCurve == "Bezier" then
            return t < 0.5 and (4*t*t*t) or (1 - ((-2*t+2)^3) / 2)
        end
        return t
    end

