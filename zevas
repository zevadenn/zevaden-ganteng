        end
    end

    -- SMOOTHING
    local function inFovShape(dx, dy, r, shape)
        if shape == "Square" then return math.abs(dx) <= r and math.abs(dy) <= r
        elseif shape == "Triangle" then
            local v0x, v0y = 0, -r
            local v1x, v1y = r * 0.86602540378, r * 0.5
            local v2x, v2y = -r * 0.86602540378, r * 0.5
            local function crs(ax, ay, bx, by) return ax * by - ay * bx end
            local d1 = crs(v1x - v0x, v1y - v0y, dx - v0x, dy - v0y)
            local d2 = crs(v2x - v1x, v2y - v1y, dx - v1x, dy - v1y)
            local d3 = crs(v0x - v2x, v0y - v2y, dx - v2x, dy - v2y)
            local hasNeg = (d1 < 0) or (d2 < 0) or (d3 < 0)
            local hasPos = (d1 > 0) or (d2 > 0) or (d3 > 0)
            return not (hasNeg and hasPos)
        end
        return dx * dx + dy * dy <= r * r
    end
    local function smoothAlpha(smth, dt, curve)
        if smth <= 0.01 then return 1 end
        local baseTau = smth * 0.4
        if curve == "Exponential" then return 1 - math.exp(-dt / (baseTau * 0.55))
        elseif curve == "Bezier" then return 1 - math.exp(-dt / (baseTau * 1.4)) end
        return 1 - math.exp(-dt / baseTau)
    end
