                    local ps, on = c:WorldToViewportPoint(hrpPos)
                    local dx, dy, dz = camPos.X - hrpPos.X, camPos.Y - hrpPos.Y, camPos.Z - hrpPos.Z
                    local dist = math.sqrt(dx*dx + dy*dy + dz*dz)
                    if on and ps.Z > 0 and dist < 600 then
                        local tS = c:WorldToViewportPoint(hrpPos + V3_HEAD)
                        local bS = c:WorldToViewportPoint(hrpPos - V3_FEET)
                        local ht = math.abs(bS.Y - tS.Y); local wd = ht / 1.6
                        local tSy = tS.Y
                        local psx, psy = ps.X, ps.Y

                        if d.B then
                            if cBox then
                                if not d.B.Visible then d.B.Visible = true end
                                d.B.Size = Vector2.new(wd, ht)
                                d.B.Position = Vector2.new(psx - wd*0.5, tSy)
                                d.B.Color = cBoxCol; d.B.Thickness = cBoxTh; d.B.Filled = cFill
                            elseif d.B.Visible then d.B.Visible = false end
                        end
                        if d.HB and d.HM then
                            if cHealth then
                                local bX = psx - wd*0.5 - 6
                                if not d.HB.Visible then d.HB.Visible = true end
                                d.HB.From = Vector2.new(bX, tSy)
                                d.HB.To = Vector2.new(bX, tSy + ht)
                                d.HB.Color = cHpCol; d.HB.Thickness = cHpTh
                                local ratio = hum.Health / hum.MaxHealth
                                if not d.HM.Visible then d.HM.Visible = true end
                                d.HM.From = Vector2.new(bX, tSy + ht)
                                d.HM.To = Vector2.new(bX, tSy + ht - (ht * ratio))
                                d.HM.Color = Color3.fromHSV(ratio * 0.3, 1, 1)
                                d.HM.Thickness = cHpTh
                            elseif d.HB.Visible or d.HM.Visible then
                                d.HB.Visible = false; d.HM.Visible = false
                            end
                        end
                        if d.D then
                            if cDist then
                                if not d.D.Visible then d.D.Visible = true end
                                d.D.Text = math.floor(dist).."m"
                                d.D.Position = Vector2.new(psx, tSy + ht + 2)
                                d.D.Color = cDistCol; d.D.Size = cFontSz
                            elseif d.D.Visible then d.D.Visible = false end
                        end
                        if d.T then
                            if cTracer then
                                if not d.T.Visible then d.T.Visible = true end
                                d.T.From = Vector2.new(halfX, 0)
                                d.T.To = Vector2.new(psx, psy)
                                d.T.Color = cTrCol; d.T.Thickness = cTrTh
                            elseif d.T.Visible then d.T.Visible = false end
                        end
                        if d.LT then
                            local head = ch:FindFirstChild("Head")
                            if cLookTr and head then
                                local hp2, onS = c:WorldToViewportPoint(head.Position)
                                local ddx, ddy = hp2.X - halfX, hp2.Y - halfY
                                local dFC = math.sqrt(ddx*ddx + ddy*ddy)
                                if onS and dFC <= cFovSize then
                                    if not d.LT.Visible then d.LT.Visible = true end
                                    d.LT.From = Vector2.new(halfX, halfY)
                                    d.LT.To = Vector2.new(hp2.X, hp2.Y)
                                    d.LT.Color = cLtCol; d.LT.Thickness = cLtTh
                                elseif d.LT.Visible then d.LT.Visible = false end
                            elseif d.LT.Visible then d.LT.Visible = false end
                        end
                        if cBone then
                            local li = 1
                            for k = 1, bPsCount do
                                local pr = bPs[k]
                                local p1, p2 = ch:FindFirstChild(pr[1]), ch:FindFirstChild(pr[2])
                                if p1 and p2 then
                                    local v1, o1 = c:WorldToViewportPoint(p1.Position)
                                    local v2, o2 = c:WorldToViewportPoint(p2.Position)
                                    local ln = d.L[li]
                                    if o1 and o2 and ln then
                                        if not ln.Visible then ln.Visible = true end
                                        ln.From = Vector2.new(v1.X, v1.Y)
                                        ln.To = Vector2.new(v2.X, v2.Y)
                                        ln.Color = cBoneCol; ln.Thickness = cBoneTh
                                        li = li + 1
                                    end
                                end
                            end
                            for i = li, 30 do
                                local ln = d.L[i]
                                if ln and ln.Visible then ln.Visible = false end
                            end
                        else
                            for i = 1, 30 do
                                local ln = d.L[i]
                                if ln and ln.Visible then ln.Visible = false end
                            end
                        end
                    else
                        if d.B and d.B.Visible then d.B.Visible = false end
                        if d.D and d.D.Visible then d.D.Visible = false end
                        if d.HB and d.HB.Visible then d.HB.Visible = false end
                        if d.HM and d.HM.Visible then d.HM.Visible = false end
                        if d.T and d.T.Visible then d.T.Visible = false end
                        if d.LT and d.LT.Visible then d.LT.Visible = false end
                        for i = 1, 30 do
                            local ln = d.L[i]
                            if ln and ln.Visible then ln.Visible = false end
                        end
                    end
                end
            else
                if d.B and d.B.Visible then d.B.Visible = false end
                if d.D and d.D.Visible then d.D.Visible = false end
                if d.HB and d.HB.Visible then d.HB.Visible = false end
                if d.HM and d.HM.Visible then d.HM.Visible = false end
                if d.T and d.T.Visible then d.T.Visible = false end
                if d.LT and d.LT.Visible then d.LT.Visible = false end
                for i = 1, 30 do
                    local ln = d.L[i]
                    if ln and ln.Visible then ln.Visible = false end
                end
            end
        end

        if cfg.Aim and not menuOpen then
            local bestScore, tg, tgPl = math.huge, nil, nil
            local useNearest = cfg.UseNearest
            local targetAll = cfg.TargetAll
            local wallCheck = cfg.WallCheck
            local targetList = cfg.TargetList
            local selectedParts = cfg.SelectedParts
            local fovSq = cFovSize * cFovSize
            for pl in pairs(cachedPlayers) do
                if v(pl) and (targetAll or targetList[pl.Name]) then
                    local ch = pl.Character
                    if useNearest then
                        for _, cd in pairs(ch:GetChildren()) do
                            if cd:IsA("BasePart") then
                                local pt = cd
                                local sP, on = c:WorldToViewportPoint(pt.Position)
                                if on then
                                    local ddx, ddy = sP.X - halfX, sP.Y - halfY
                                    if (ddx*ddx + ddy*ddy) < fovSq then
                                        if not wallCheck or vis(pt) then
                                            local sc = scoreTarget(pl, pt, camPos, halfX, halfY)
                                            if sc < bestScore then bestScore = sc; tg = pt; tgPl = pl end
                                        end
                                    end
                                end
                            end
                        end
                    else
                        for pN, ac in pairs(selectedParts) do
                            if ac then
                                local pt = ch:FindFirstChild(pN)
                                if pt then
                                    local sP, on = c:WorldToViewportPoint(pt.Position)
                                    if on then
                                        local ddx, ddy = sP.X - halfX, sP.Y - halfY
                                        if (ddx*ddx + ddy*ddy) < fovSq then
                                            if not wallCheck or vis(pt) then
                                                local sc = scoreTarget(pl, pt, camPos, halfX, halfY)
                                                if sc < bestScore then bestScore = sc; tg = pt; tgPl = pl end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
            if tg and tgPl then
                local aimPos = CalcPred(tgPl, tg)
                if aimPos then
                    local rx, ry = 0, 0
                    if cfg.JitterAim then
                        rx = (math.random() - 0.5) * 2 * cfg.RandOffsetX
                        ry = (math.random() - 0.5) * 2 * cfg.RandOffsetY
                    end
                    local rv, uv = camCF.RightVector, camCF.UpVector
                    currentAimPos = aimPos + rv * (cfg.OffsetX + rx) + uv * (cfg.OffsetY + ry)
                end
            else currentAimPos = nil end
        else currentAimPos = nil end

        if cfg.KillStats then
            local ks = _G.__zeva_killStatsGui
            if not ks or not ks.sg or not ks.sg.Parent then
                local sg = Instance.new("ScreenGui", p.PlayerGui)
                sg.Name = "zeva_ks_"..tostring(math.random(1e6,9e6)); sg.ResetOnSpawn = false; sg.IgnoreGuiInset = true; sg.DisplayOrder = 40
                local lbl = Instance.new("TextLabel", sg)
                lbl.Size, lbl.Position, lbl.BackgroundColor3, lbl.BackgroundTransparency =
                    UDim2.new(0,200,0,40), UDim2.new(1,-210,0,10), TH.Bg, 0.35
                lbl.TextColor3, lbl.Font, lbl.TextSize, lbl.BorderSizePixel, lbl.Text = TH.Text, FONTB, 13, 0, ""
                round(lbl, 8); stroke(lbl, TH.LineSoft, 1, 0.4)
                _G.__zeva_killStatsGui = {sg = sg, lbl = lbl}; ks = _G.__zeva_killStatsGui
            end
            local txt = "Hits: " .. killStats.hits
            if ks.lbl.Text ~= txt then ks.lbl.Text = txt end
            if not ks.sg.Enabled then ks.sg.Enabled = true end
        elseif _G.__zeva_killStatsGui and _G.__zeva_killStatsGui.sg and _G.__zeva_killStatsGui.sg.Enabled then
            _G.__zeva_killStatsGui.sg.Enabled = false
        end

        local nowT = tick()
        local removedAny = false
        for i = #killFeed, 1, -1 do
            if nowT - killFeed[i].born > 4 then table.remove(killFeed, i); removedAny = true end
        end
        if cfg.KillFeed then
            if not _G.__zeva_killFeedGui or not _G.__zeva_killFeedGui.sg or not _G.__zeva_killFeedGui.sg.Parent then
                local sg = Instance.new("ScreenGui", p.PlayerGui)
                sg.Name = "zeva_kf_"..tostring(math.random(1e6,9e6)); sg.ResetOnSpawn = false; sg.IgnoreGuiInset = true; sg.DisplayOrder = 40
                local holder = Instance.new("Frame", sg)
                holder.Size, holder.Position, holder.BackgroundTransparency = UDim2.new(0,260,0,200), UDim2.new(1,-270,1,-220), 1
                local lay = Instance.new("UIListLayout", holder)
                lay.SortOrder, lay.VerticalAlignment, lay.Padding = Enum.SortOrder.LayoutOrder, Enum.VerticalAlignment.Bottom, UDim.new(0,4)
                _G.__zeva_killFeedGui = {sg = sg, holder = holder}
            end
            local kf = _G.__zeva_killFeedGui
            if removedAny or #killFeed ~= lastKFCount then
                lastKFCount = #killFeed
                local sig = tostring(#killFeed)
                for i = 1, #killFeed do sig = sig .. "|" .. killFeed[i].name end
                if sig ~= killFeedSig then
                    killFeedSig = sig
                    for _, ch in ipairs(kf.holder:GetChildren()) do if ch:IsA("TextLabel") then ch:Destroy() end end
                    for i, it in ipairs(killFeed) do
                        local lbl = Instance.new("TextLabel", kf.holder)
                        lbl.Size, lbl.BackgroundColor3, lbl.BackgroundTransparency = UDim2.new(1,0,0,22), TH.Bg, 0.3
                        lbl.TextColor3, lbl.Font, lbl.TextSize, lbl.Text, lbl.BorderSizePixel, lbl.LayoutOrder =
                            TH.Text, FONTB, 11, "×  "..it.name, 0, i
                        round(lbl, 4)
                    end
                end
            end
            if not kf.sg.Enabled then kf.sg.Enabled = true end
        elseif _G.__zeva_killFeedGui and _G.__zeva_killFeedGui.sg and _G.__zeva_killFeedGui.sg.Enabled then
            _G.__zeva_killFeedGui.sg.Enabled = false
        end

        if cfg.Radar then
            if not _G.__zeva_radarGui or not _G.__zeva_radarGui.sg or not _G.__zeva_radarGui.sg.Parent then
                local sg = Instance.new("ScreenGui", p.PlayerGui)
                sg.Name = "zeva_radar_"..tostring(math.random(1e6,9e6)); sg.ResetOnSpawn = false; sg.IgnoreGuiInset = true; sg.DisplayOrder = 40
                local frame = Instance.new("Frame", sg)
                frame.Size, frame.Position, frame.BackgroundColor3, frame.BackgroundTransparency, frame.BorderSizePixel, frame.ClipsDescendants =
                    UDim2.new(0,cfg.RadarSize,0,cfg.RadarSize), UDim2.new(0,20,0,100), TH.Bg, 0.35, 0, true
                round(frame, 8); stroke(frame, TH.LineSoft, 1, 0.4)
                local holder = Instance.new("Frame", frame)
                holder.Size, holder.BackgroundTransparency = UDim2.new(1,0,1,0), 1
                local selfDot = Instance.new("Frame", holder)
                selfDot.Size, selfDot.BackgroundColor3, selfDot.BorderSizePixel = UDim2.new(0,6,0,6), TH.Accent, 0
                round(selfDot, 3)
                _G.__zeva_radarGui = {sg = sg, frame = frame, holder = holder, selfDot = selfDot, dots = {}}
            end
            local rd = _G.__zeva_radarGui
            if rd.frame.Size.X.Offset ~= cfg.RadarSize then
                rd.frame.Size = UDim2.new(0,cfg.RadarSize,0,cfg.RadarSize)
            end
            local half = cfg.RadarSize * 0.5
            local range = cfg.RadarRange
            rd.selfDot.Position = UDim2.new(0, half - 3, 0, half - 3)
            local look = camCF.LookVector
            local yaw = math.atan2(look.X, look.Z)
            local cosY, sinY = math.cos(yaw), math.sin(yaw)
            local dots = rd.dots
            local idx = 0
            for pl in pairs(cachedPlayers) do
                if pl ~= p then
                    local ch = pl.Character
                    if ch then
                        local hrp = ch:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local rel = hrp.Position - camPos
                            local dx, dz = rel.X, rel.Z
                            local dist = math.sqrt(dx*dx + dz*dz)
                            if dist < range then
                                idx = idx + 1
                                local dot = dots[idx]
                                if not dot or not dot.Parent then
                                    dot = Instance.new("Frame", rd.holder)
                                    dot.Size, dot.BackgroundColor3, dot.BorderSizePixel = UDim2.new(0,6,0,6), TH.Danger, 0
                                    round(dot, 3); dots[idx] = dot
                                end
                                local rx = dx * cosY - dz * sinY
                                local rz = dx * sinY + dz * cosY
                                local sx = half + (rx / range) * half
                                local sy = half - (rz / range) * half
                                dot.Position = UDim2.new(0, sx - 3, 0, sy - 3)
                                dot.Visible = true
                            end
                        end
                    end
                end
            end
            for i = idx + 1, #dots do if dots[i] then dots[i].Visible = false end end
            if not rd.sg.Enabled then rd.sg.Enabled = true end
        elseif _G.__zeva_radarGui and _G.__zeva_radarGui.sg and _G.__zeva_radarGui.sg.Enabled then
            _G.__zeva_radarGui.sg.Enabled = false
        end

        if cfg.FPSOverlay then
            if not _G.__zeva_fpsGui or not _G.__zeva_fpsGui.sg or not _G.__zeva_fpsGui.sg.Parent then
                local sg = Instance.new("ScreenGui", p.PlayerGui)
                sg.Name = "zeva_fps_"..tostring(math.random(1e6,9e6)); sg.ResetOnSpawn = false; sg.IgnoreGuiInset = true; sg.DisplayOrder = 40
                local lbl = Instance.new("TextLabel", sg)
                lbl.Size, lbl.Position, lbl.BackgroundColor3, lbl.BackgroundTransparency = UDim2.new(0,200,0,24), UDim2.new(1,-210,0,10), TH.Bg, 0.4
                lbl.TextColor3, lbl.Font, lbl.TextSize, lbl.BorderSizePixel, lbl.Text, lbl.TextXAlignment =
                    TH.Accent, FONTB, 12, 0, "", Enum.TextXAlignment.Left
                local pp = Instance.new("UIPadding", lbl); pp.PaddingLeft = UDim.new(0,8)
                round(lbl, 6); stroke(lbl, TH.LineSoft, 1, 0.4)
                _G.__zeva_fpsGui = {sg = sg, lbl = lbl}
            end
            local fg = _G.__zeva_fpsGui
            local txt = "FPS: "..fpsValue.."   Ping: "..pingValue.."ms"
            if fg.lbl.Text ~= txt then fg.lbl.Text = txt end
            if not fg.sg.Enabled then fg.sg.Enabled = true end
        elseif _G.__zeva_fpsGui and _G.__zeva_fpsGui.sg and _G.__zeva_fpsGui.sg.Enabled then
            _G.__zeva_fpsGui.sg.Enabled = false
        end
    end)

    task.spawn(function()
        local lastT, lastHit = 0, 0
        while g and g.Parent do
            if cfg.Trig and not root.Visible then
                local now = tick()
                if now - lastT > cfg.Dly then
                    local vs = c.ViewportSize
                    local scx, scy = math.floor(vs.X*0.5), math.floor(vs.Y*0.5)
                    local ray = c:ViewportPointToRay(scx, scy)
                    local rp = RaycastParams.new()
                    rp.FilterDescendantsInstances = {p.Character, c}
                    rp.FilterType = Enum.RaycastFilterType.Blacklist
                    local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, rp)
                    if result and result.Instance then
                        local model = result.Instance:FindFirstAncestorOfClass("Model")
                        local hitPl = model and P:GetPlayerFromCharacter(model)
                        if hitPl and v(hitPl) then
                            local hd = (result.Position - ray.Origin).Magnitude
                            if hd <= cfg.MaxTriggerDist and (not cfg.WallCheck or vis(result.Instance)) then
                                pcall(function()
                                    VIM:SendMouseButtonEvent(scx, scy, 0, true, game, 1)
                                    RS.Heartbeat:Wait()
                                    VIM:SendMouseButtonEvent(scx, scy, 0, false, game, 1)
                                end)
                                lastT = tick() + math.max(0.03, math.random() * cfg.RandDelay)
                                killStats.hits = killStats.hits + 1
                                if cfg.HitSound and hitSound and tick() - lastHit > 0.15 then hitSound:Play(); lastHit = tick() end
                            end
                        end
                    end
                end
            end
            RS.Heartbeat:Wait()
        end
    end)

    reg(P.PlayerRemoving:Connect(function(pl)
        local d = dr[pl]
        if d then
            pcall(function() if d.B then d.B:Remove() end end)
            pcall(function() if d.HB then d.HB:Remove() end end)
            pcall(function() if d.HM then d.HM:Remove() end end)
            pcall(function() if d.D then d.D:Remove() end end)
            pcall(function() if d.T then d.T:Remove() end end)
            pcall(function() if d.LT then d.LT:Remove() end end)
            for _, l in pairs(d.L) do pcall(function() if l then l:Remove() end end) end
            dr[pl] = nil
        end
        local hc = hitChams[pl]
        if hc then pcall(function() hc.sq:Remove() end); hitChams[pl] = nil end
        lastHealth[pl] = nil; velHist[pl] = nil
    end))
end

buildSelector()