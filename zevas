        return BH_NAMES[part.Name] == true
    end

    local function bh_snapshot(part)
        if bhCache[part] then return end
        bhCache[part] = {
            Size = part.Size, Transparency = part.Transparency,
            LocalTransparencyModifier = part.LocalTransparencyModifier,
            CanCollide = part.CanCollide, CanQuery = part.CanQuery,
            CanTouch = part.CanTouch, Massless = part.Massless, children = {},
        }
    end

    local function bh_hideChildren(part)
        local snap = bhCache[part]
        if not snap then return end
        for _, ch in ipairs(part:GetDescendants()) do
            if not snap.children[ch] then snap.children[ch] = {} end
            local saved = snap.children[ch]
            if ch:IsA("Decal") or ch:IsA("Texture") or ch:IsA("SurfaceAppearance") then
                if saved.Transparency == nil then saved.Transparency = ch.Transparency end
                ch.Transparency = 1
            elseif ch:IsA("SpecialMesh") or ch:IsA("BlockMesh") or ch:IsA("CylinderMesh")
                or ch:IsA("SphereMesh") or ch:IsA("FileMesh") or ch:IsA("BevelMesh") then
                if saved.Scale == nil then saved.Scale = ch.Scale end
                ch.Scale = Vector3.zero
            elseif ch:IsA("ParticleEmitter") or ch:IsA("Trail") or ch:IsA("Beam")
                or ch:IsA("Fire") or ch:IsA("Smoke") or ch:IsA("Sparkles") then
                if saved.Enabled == nil then saved.Enabled = ch.Enabled end
                ch.Enabled = false
            elseif ch:IsA("BillboardGui") or ch:IsA("SurfaceGui") then
                if saved.Enabled == nil then saved.Enabled = ch.Enabled end
                ch.Enabled = false
            elseif ch:IsA("BasePart") then
                if saved.LocalTransparencyModifier == nil then
                    saved.LocalTransparencyModifier = ch.LocalTransparencyModifier
                    saved.Transparency2 = ch.Transparency
                end
                ch.LocalTransparencyModifier = 1
                ch.Transparency = 1
                for _, cc in ipairs(ch:GetDescendants()) do
                    if cc:IsA("Decal") or cc:IsA("Texture") then
                        if not snap.children[cc] then snap.children[cc] = {} end
                        if snap.children[cc].Transparency == nil then
                            snap.children[cc].Transparency = cc.Transparency
                        end
                        cc.Transparency = 1
                    end
                end
            end
        end
    end

    local function bh_restoreChildren(part)
        local snap = bhCache[part]
        if not snap then return end
        for ch, saved in pairs(snap.children) do
            pcall(function()
                if not ch or not ch.Parent then return end
                if saved.Transparency ~= nil and ch.Transparency ~= nil then ch.Transparency = saved.Transparency end
                if saved.Transparency2 ~= nil then ch.Transparency = saved.Transparency2 end
                if saved.Scale ~= nil then ch.Scale = saved.Scale end
                if saved.Enabled ~= nil then ch.Enabled = saved.Enabled end
                if saved.LocalTransparencyModifier ~= nil then ch.LocalTransparencyModifier = saved.LocalTransparencyModifier end
            end)
        end
        snap.children = {}
    end

