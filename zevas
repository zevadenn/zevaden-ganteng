-- ==================== RENDER LOOP ====================
local radarFrame = 0

RunService.RenderStepped:Connect(function(dt)
    if not HasDrawing then return end
    if not cfg.Enabled then
        for _, d in pairs(drawings) do
            if d.B then d.B.Visible = false end
            if d.BF then d.BF.Visible = false end
            if d.HB then d.HB.Visible = false end
            if d.HM then d.HM.Visible = false end
            if d.HPText then d.HPText.Visible = false end
            if d.D then d.D.Visible = false end
            if d.T then d.T.Visible = false end
            if d.LT then d.LT.Visible = false end
            if d.Name then d.Name.Visible = false end
            if d.Weapon then d.Weapon.Visible = false end
            if d.HeadDot then d.HeadDot.Visible = false end
            if d.Hat then d.Hat.Visible = false end
            if d.Arrow then for _,ln in ipairs(d.Arrow) do if ln then ln.Visible=false end end end
            for i = 1, #d.L do if d.L[i] then d.L[i].Visible = false end end
            for i = 1, #d.C_Lines do if d.C_Lines[i] then d.C_Lines[i].Visible = false end end
        end
        hideAllArrows()
        return
    end

    local Camera = workspace.CurrentCamera
    if not Camera then return end
    local vs = Camera.ViewportSize
    local halfX, halfY = vs.X * 0.5, vs.Y * 0.5
    local camCF = Camera.CFrame
    local camPos = camCF.Position
    local anyESP = (
        cfg.Box or cfg.BoxFilled or cfg.Health or cfg.Dist or cfg.Tracer or
        cfg.LookTracer or cfg.Bone or cfg.NameESP or cfg.HeadDot or
        cfg.OffscreenArrows or cfg.WeaponESP or cfg.ChinaHat
    )

    for pl, d in pairs(drawings) do
        local ch = pl.Character
        local visible = anyESP and ch and isValid(pl)

        if visible then
            if d.charCache ~= ch then
                d.charCache = ch
                d.hrp = ch:FindFirstChild("HumanoidRootPart")
                d.hum = ch:FindFirstChildOfClass("Humanoid")
                d.boneCache = nil
            end
            local hrp, hum = d.hrp, d.hum
            if hrp and hrp.Parent and hum and hum.Parent then
                local hrpPos = hrp.Position
                local dx, dy, dz = camPos.X - hrpPos.X, camPos.Y - hrpPos.Y, camPos.Z - hrpPos.Z
                local distSq = dx*dx + dy*dy + dz*dz
                local ps, on, dist

                local maxD = cfg.MaxDistance or 500
                if distSq < (maxD * maxD) then
                    ps, on = Camera:WorldToViewportPoint(hrpPos)
                    dist = math.sqrt(distSq)
                    if not on or ps.Z <= 0 then
                        on = false
                    elseif ps.X < -20 or ps.X > vs.X + 20 or ps.Y < -20 or ps.Y > vs.Y + 20 then
                        on = false
                    end
                else
                    on = false
                    dist = math.sqrt(distSq)
                end

                if on then
                    local tS = Camera:WorldToViewportPoint(hrpPos + V3_HEAD)
                    local bS = Camera:WorldToViewportPoint(hrpPos - V3_FEET)
                    local ht = math.abs(bS.Y - tS.Y)
                    local wd = ht / 1.6
                    local tSy, psx, psy = tS.Y, ps.X, ps.Y

                    local boxCol, boneCol = cfg.BoxColor, cfg.BoneColor
                    if cfg.VisCheckColor then
                        local head = ch:FindFirstChild("Head")
                        local vis = head and isVisible(head)
                        boxCol = vis and cfg.VisibleColor or cfg.HiddenColor
                        boneCol = boxCol
                    end

                    if d.B then
                        if cfg.Box and cfg.BoxStyle == "2D" then
                            d.B.Visible = true
                            d.B.Size = Vector2.new(wd, ht)
                            d.B.Position = Vector2.new(psx - wd*0.5, tSy)
                            d.B.Color = boxCol; d.B.Thickness = cfg.BoxThickness; d.B.Filled = false
                        else d.B.Visible = false end
                    end

                    if d.C_Lines then
                        if cfg.Box and cfg.BoxStyle == "Corner" then
                            local tL = Vector2.new(psx-wd*0.5, tSy)
                            local tR = Vector2.new(psx+wd*0.5, tSy)
                            local bL = Vector2.new(psx-wd*0.5, tSy+ht)
                            local bR = Vector2.new(psx+wd*0.5, tSy+ht)
                            local cL = math.min(wd, ht) * 0.2
                            local corners = {
                                {tL, tL+Vector2.new(cL,0)}, {tL, tL+Vector2.new(0,cL)},
                                {tR, tR-Vector2.new(cL,0)}, {tR, tR+Vector2.new(0,cL)},
                                {bL, bL+Vector2.new(cL,0)}, {bL, bL-Vector2.new(0,cL)},
                                {bR, bR-Vector2.new(cL,0)}, {bR, bR-Vector2.new(0,cL)},
                            }
                            for i = 1, 8 do
                                local ln = d.C_Lines[i]
                                if ln then
                                    ln.Visible = true; ln.Color = boxCol; ln.Thickness = cfg.BoxThickness
                                    setLine(ln, corners[i][1], corners[i][2])
                                end
                            end
                        else
                            for i = 1, 8 do if d.C_Lines[i] then d.C_Lines[i].Visible = false end end
                        end
                    end

                    if d.BF then
                        if cfg.BoxFilled then
                            d.BF.Visible = true
                            d.BF.Size = Vector2.new(wd, ht)
                            d.BF.Position = Vector2.new(psx-wd*0.5, tSy)
                            d.BF.Color = cfg.BoxFilledColor
                            d.BF.Transparency = cfg.BoxFilledTransparency
                        else d.BF.Visible = false end
                    end

                    if d.HeadDot then
                        if cfg.HeadDot then
                            local head = ch:FindFirstChild("Head")
                            if head then
                                local hp2, onH = Camera:WorldToViewportPoint(head.Position)
                                if onH and hp2.Z > 0 then
                                    d.HeadDot.Visible = true
                                    d.HeadDot.Position = Vector2.new(hp2.X, hp2.Y)
                                    d.HeadDot.Radius = cfg.HeadDotSize
                                    d.HeadDot.Color = cfg.HeadDotColor
                                else d.HeadDot.Visible = false end
                            else d.HeadDot.Visible = false end
                        else d.HeadDot.Visible = false end
                    end


                    if d.Hat then
                        if cfg.ChinaHat then
                            local head = ch:FindFirstChild("Head")
                            if head then
                                local top = head.Position + Vector3.new(0, head.Size.Y * 0.55, 0)
                                local hp2, onH = Camera:WorldToViewportPoint(top)
                                if onH and hp2.Z > 0 then
                                    d.Hat.Visible = true
                                    d.Hat.Position = Vector2.new(hp2.X, hp2.Y)
                                    d.Hat.Radius = math.clamp(28 / math.max(dist, 8), 3, 10)
                                    d.Hat.Color = cfg.ChinaHatColor
                                    d.Hat.Thickness = 2
                                    d.Hat.Filled = false
                                else d.Hat.Visible = false end
                            else d.Hat.Visible = false end
                        else d.Hat.Visible = false end
                    end

                    if d.Weapon then
                        if cfg.WeaponESP then
                            local toolName
                            local tool = ch:FindFirstChildOfClass("Tool")
                            if tool then toolName = tool.Name
                            else
                                for _, child in ipairs(ch:GetChildren()) do
                                    if child:IsA("Tool") or (child:IsA("Model") and child:FindFirstChild("Handle")) then
                                        toolName = child.Name; break
                                    end
                                end
                            end
                            if toolName then
                                d.Weapon.Visible = true
                                d.Weapon.Text = toolName
                                d.Weapon.Position = Vector2.new(psx, tSy + ht + 14)
                                d.Weapon.Color = cfg.WeaponColor
                            else d.Weapon.Visible = false end
                        else d.Weapon.Visible = false end
                    end

                    if d.HB and d.HM and d.HPText then
                        if cfg.Health then
                            local bX = psx - wd*0.5 - 6
                            local ratio = hum.MaxHealth > 0 and math.clamp(hum.Health/hum.MaxHealth, 0, 1) or 1
                            d.HB.Visible = true
                            setLine(d.HB, Vector2.new(bX, tSy), Vector2.new(bX, tSy+ht))
                            d.HB.Color = Color3.new(0,0,0); d.HB.Thickness = cfg.HealthThickness + 2
                            d.HM.Visible = true
                            setLine(d.HM, Vector2.new(bX, tSy+ht), Vector2.new(bX, tSy+ht-(ht*ratio)))
                            d.HM.Color = Color3.fromHSV(ratio*0.3, 1, 1); d.HM.Thickness = cfg.HealthThickness
                            if cfg.ShowHPText then
                                d.HPText.Visible = true
                                d.HPText.Text = tostring(math.floor(hum.Health))
                                d.HPText.Position = Vector2.new(bX-6, tSy+ht-(ht*ratio))
                                d.HPText.Color = Color3.fromHSV(ratio*0.3, 1, 1)
                            else d.HPText.Visible = false end
                        else
                            d.HB.Visible = false; d.HM.Visible = false; d.HPText.Visible = false
                        end
                    end

                    if d.Name then
                        if cfg.NameESP then
                            local sideX = cfg.Health and (psx+wd*0.5+12) or (psx-wd*0.5-12)
                            d.Name.Visible = true
                            d.Name.Text = pl.DisplayName
                            d.Name.Position = Vector2.new(sideX, tSy + ht*0.5)
                            d.Name.Color = cfg.NameColor; d.Name.Size = cfg.NameSize
                        else d.Name.Visible = false end
                    end

                    if d.D then
                        if cfg.Dist then
                            d.D.Visible = true
                            d.D.Text = math.floor(dist).."m"
                            d.D.Position = Vector2.new(psx, tSy+ht+2)
                            d.D.Color = cfg.DistanceColor; d.D.Size = cfg.ESPFontSize
                        else d.D.Visible = false end
                    end

                    if d.T then
                        if cfg.Tracer then
                            d.T.Visible = true
                            local startY = cfg.TracerOrigin == "Top" and 0 or (cfg.TracerOrigin == "Bottom" and vs.Y or vs.Y*0.5)
                            setLine(d.T, Vector2.new(halfX, startY), Vector2.new(psx, psy))
                            d.T.Color = cfg.TracerColor; d.T.Thickness = cfg.TracerThickness
                        else d.T.Visible = false end
                    end

                    if d.LT then
                        local originPart = cfg.LookTracerOrigin == "Body" and hrp or ch:FindFirstChild("Head")
                        if cfg.LookTracer and originPart then
                            local origin = originPart.Position
                            local tip = origin + originPart.CFrame.LookVector * cfg.LookTracerLength
                            local p1 = Camera:WorldToViewportPoint(origin)
                            local p2 = Camera:WorldToViewportPoint(tip)
                            if p1.Z > 0 and p2.Z > 0 then
                                local trans = cfg.LookTracerTransparency
                                if cfg.LookTracerAnimate then trans = trans * (0.5 + 0.5*math.sin(tick()*8)) end
                                d.LT.Visible = true
                                setLine(d.LT, Vector2.new(p1.X, p1.Y), Vector2.new(p2.X, p2.Y))
                                d.LT.Color = cfg.LookTracerColor
                                d.LT.Thickness = cfg.LookTracerThickness
                                d.LT.Transparency = trans
                            else d.LT.Visible = false end
                        else d.LT.Visible = false end
                    end

                    if cfg.Bone then
                        local bp = ch:FindFirstChild("UpperTorso") and BONE_PAIRS_R15 or BONE_PAIRS_R6
                        local bpCount = #bp
                        local li = 1
                        if not d.boneCache or d.boneCache.char ~= ch or d.boneCache.count ~= bpCount then
                            d.boneCache = {char=ch, count=bpCount, parts={}}
                            for k = 1, bpCount do
                                local pr = bp[k]
                                d.boneCache.parts[k] = {ch:FindFirstChild(pr[1]), ch:FindFirstChild(pr[2])}
                            end
                        end
                        for k = 1, bpCount do
                            local cached = d.boneCache.parts[k]
                            local p1, p2 = cached[1], cached[2]
                            if p1 and p2 then
                                local v1, o1 = Camera:WorldToViewportPoint(p1.Position)
                                local v2, o2 = Camera:WorldToViewportPoint(p2.Position)
                                local ln = d.L[li]
                                if o1 and o2 and ln then
                                    ln.Visible = true
                                    setLine(ln, Vector2.new(v1.X, v1.Y), Vector2.new(v2.X, v2.Y))
                                    ln.Color = boneCol; ln.Thickness = cfg.BoneThickness
                                    li = li + 1
                                end
                            end
                        end
                        for i = li, BONE_COUNT do if d.L[i] then d.L[i].Visible = false end end
                    else
                        for i = 1, BONE_COUNT do if d.L[i] then d.L[i].Visible = false end end
                    end
                else
                    if d.B then d.B.Visible = false end
                    if d.BF then d.BF.Visible = false end
                    if d.HeadDot then d.HeadDot.Visible = false end
                    if d.Hat then d.Hat.Visible = false end
                    if d.Weapon then d.Weapon.Visible = false end
                    if d.C_Lines then for i=1,8 do if d.C_Lines[i] then d.C_Lines[i].Visible = false end end end
                    if d.Name then d.Name.Visible = false end
                    if d.D then d.D.Visible = false end
                    if d.HB then d.HB.Visible = false end
                    if d.HM then d.HM.Visible = false end
                    if d.HPText then d.HPText.Visible = false end
                    if d.T then d.T.Visible = false end
                    if d.LT then d.LT.Visible = false end
                    for i = 1, BONE_COUNT do if d.L[i] then d.L[i].Visible = false end end

                end

                -- arrows handled in global pass below

            end
        else
            if d.B then d.B.Visible = false end
            if d.BF then d.BF.Visible = false end
            if d.HeadDot then d.HeadDot.Visible = false end
                    if d.Hat then d.Hat.Visible = false end
            if d.Weapon then d.Weapon.Visible = false end
            if d.Arrow then for _,ln in ipairs(d.Arrow) do if ln then ln.Visible=false end end end
            if d.C_Lines then for i=1,8 do if d.C_Lines[i] then d.C_Lines[i].Visible = false end end end
            if d.Name then d.Name.Visible = false end
            if d.D then d.D.Visible = false end
            if d.HB then d.HB.Visible = false end
            if d.HM then d.HM.Visible = false end
            if d.HPText then d.HPText.Visible = false end
            if d.T then d.T.Visible = false end
            if d.LT then d.LT.Visible = false end
            for i = 1, BONE_COUNT do if d.L[i] then d.L[i].Visible = false end end
        end
    end


    -- ===== Offscreen arrows (ScreenGui) =====
    if cfg.Enabled and cfg.OffscreenArrows then
        local arrowIdx = 0
        for pl, d in pairs(drawings) do
            if isValid(pl) and pl.Character then
                local hrp = pl.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local hrpPos = hrp.Position
                    local dx = camPos.X - hrpPos.X
                    local dy = camPos.Y - hrpPos.Y
                    local dz = camPos.Z - hrpPos.Z
                    local distSq = dx*dx + dy*dy + dz*dz
                    local maxD = cfg.MaxDistance or 500
                    if distSq < maxD * maxD then
                        local spA, onA = Camera:WorldToViewportPoint(hrpPos)
                        local off = (not onA) or (spA.Z <= 0)
                            or spA.X < -5 or spA.X > vs.X + 5
                            or spA.Y < -5 or spA.Y > vs.Y + 5
                        if off then
                            local dir = hrpPos - camPos
                            local flat = Vector3.new(dir.X, 0, dir.Z)
                            if flat.Magnitude > 0.05 then
                                local look = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
                                if look.Magnitude < 0.05 then look = Vector3.new(0, 0, -1) end
                                look = look.Unit
                                local right = Vector3.new(-look.Z, 0, look.X)
                                local f = flat.Unit
                                local angle = math.atan2(f:Dot(right), f:Dot(look))
                                local margin = 36
                                local radius = math.min(halfX, halfY) - margin
                                if radius < 20 then radius = 60 end
                                local ax = math.clamp(halfX + math.sin(angle) * radius, margin, vs.X - margin)
                                local ay = math.clamp(halfY - math.cos(angle) * radius, margin, vs.Y - margin)
                                -- rotation: 0 = up, match sin/cos angle
                                local deg = math.deg(angle)
                                arrowIdx = arrowIdx + 1
                                local item = getArrowItem(arrowIdx)
                                item.frame.Position = UDim2.fromOffset(ax, ay)
                                item.frame.Rotation = deg
                                item.frame.TextColor3 = cfg.ArrowColor or Color3.fromRGB(255, 80, 80)
                                item.frame.TextSize = math.clamp((cfg.ArrowSize or 14) + 10, 18, 32)
                                item.frame.Visible = true
                            end
                        end
                    end
                end
            end
        end
        for i = arrowIdx + 1, #arrowPool do
            if arrowPool[i] and arrowPool[i].frame then
                arrowPool[i].frame.Visible = false
            end
        end
    else
        hideAllArrows()
    end

    radarFrame = radarFrame + 1
    if radarFrame % 2 == 0 then
        if cfg.Radar then
            local rd = ensureRadar()
            if rd.frame and rd.frame.Size.X.Offset ~= (cfg.RadarSize or 140) then
                rd.frame.Size = UDim2.new(0, cfg.RadarSize or 140, 0, cfg.RadarSize or 140)
            end
            local half = cfg.RadarSize * 0.5
            local range = cfg.RadarRange
            local targetYaw = math.atan2(camCF.LookVector.X, -camCF.LookVector.Z)
            if rd.lastYaw == nil then rd.lastYaw = targetYaw end
            local diff = (targetYaw - rd.lastYaw + math.pi) % (math.pi*2) - math.pi
            rd.lastYaw = rd.lastYaw + diff * math.min(1, dt*12)
            local camYaw = rd.lastYaw
            if rd.selfDot then rd.selfDot.BackgroundColor3 = cfg.RadarSelfColor end
            if rd.selfLine then rd.selfLine.BackgroundColor3 = cfg.RadarSelfColor end

            local dots, idx = rd.dots, 0
            for pl in pairs(cachedPlayers) do
                if not isKOorDead_cached(pl) then
                    local ch = pl.Character
                    if ch then
                        local hrp = ch:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local rel = hrp.Position - camPos
                            local dist = math.sqrt(rel.X*rel.X + rel.Z*rel.Z)
                            if dist < range then
                                idx = idx + 1
                                local dItem = dots[idx]
                                if not dItem or not dItem.container.Parent then
                                    local container = Instance.new("Frame", rd.holder)
                                    container.Size = UDim2.new(0,18,0,18)
                                    container.AnchorPoint = Vector2.new(0.5,0.5)
                                    container.BackgroundTransparency = 1; container.ZIndex = 2
                                    local aimLine = Instance.new("Frame", container)
                                    aimLine.Size = UDim2.new(0,2,0,9)
                                    aimLine.AnchorPoint = Vector2.new(0.5,0.5)
                                    aimLine.Position = UDim2.new(0.5,0,0.5,-4.5)
                                    aimLine.BorderSizePixel = 0; round(aimLine, 1)
                                    local dot = Instance.new("Frame", container)
                                    dot.Size = UDim2.new(0,5,0,5)
                                    dot.AnchorPoint = Vector2.new(0.5,0.5)
                                    dot.Position = UDim2.new(0.5,0,0.5,0)
                                    dot.BorderSizePixel = 0; round(dot, 3)
                                    dItem = {container=container, aimLine=aimLine, dot=dot}
                                    dots[idx] = dItem
                                end
                                local targetAngle = math.atan2(rel.X, -rel.Z)
                                local relAngle = targetAngle - camYaw
                                local sx = half + math.sin(relAngle) * (dist/range) * half
                                local sy = half - math.cos(relAngle) * (dist/range) * half
                                dItem.container.Position = UDim2.new(0, sx, 0, sy)
                                dItem.container.Visible = true
                                local isTeam = cfg.TeamCheck and pl.Team and LocalPlayer.Team and pl.Team == LocalPlayer.Team
                                local col = isTeam and cfg.RadarTeamColor or cfg.RadarEnemyColor
                                dItem.dot.BackgroundColor3 = col
                                dItem.aimLine.BackgroundColor3 = col
                                local look = hrp.CFrame.LookVector
                                local pAim = math.atan2(look.X, -look.Z)
                                dItem.aimLine.Rotation = math.deg(pAim - camYaw)
                            end
                        end
                    end
                end
            end
            for i = idx+1, #dots do if dots[i] and dots[i].container then dots[i].container.Visible = false end end
            if not rd.sg.Enabled then rd.sg.Enabled = true end
        else
            destroyRadar()
        end
    end
end)

