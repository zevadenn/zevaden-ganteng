                colorPointer = {
                    touch = touchOf(input),
                    move = pointAt,
                }
                pointAt(input.Position)
            end
        end)
    end

    hex.FocusLost:Connect(function()
        local digits = hex.Text:match("^#?(%x%x%x%x%x%x)$")
        if digits then
            hue, saturation, value = Color3.fromHex(digits):ToHSV()
        end
        apply()
    end)

    closeBtn.Activated:Connect(function()
        apply()
        closeColorPicker()
        if toast then toast("Color set") end
    end)
    closeBtn.MouseButton1Click:Connect(function()
        apply()
        closeColorPicker()
    end)

    apply()
end

