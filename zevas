local function sliderS(parent, label, key, min, max, isFloat)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, 0, 0, 40)
    row.BackgroundTransparency = 1
    row.LayoutOrder = #parent:GetChildren()
    row.ZIndex = 12
    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(1, -50, 0, 16)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = TH.Text
    lbl.Font = FONT
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 13
    local val = Instance.new("TextLabel", row)
    val.Size = UDim2.new(0, 48, 0, 16)
    val.Position = UDim2.new(1, -48, 0, 0)
    val.BackgroundTransparency = 1
    val.Text = isFloat and string.format("%.2f", Settings[key] or min) or tostring(math.floor(Settings[key] or min))
    val.TextColor3 = TH.Accent
    val.Font = FONTB
    val.TextSize = 11
    val.TextXAlignment = Enum.TextXAlignment.Right
    val.ZIndex = 13
    local track = Instance.new("Frame", row)
    track.Size = UDim2.new(1, 0, 0, 6)
    track.Position = UDim2.new(0, 0, 0, 22)
    track.BackgroundColor3 = TH.Off
    track.BorderSizePixel = 0
    track.ZIndex = 13
    round(track, 3)
    local fill = Instance.new("Frame", track)
    local ratio = math.clamp(((Settings[key] or min) - min) / (max - min), 0, 1)
    fill.Size = UDim2.new(ratio, 0, 1, 0)
    fill.BackgroundColor3 = TH.Accent
    fill.BorderSizePixel = 0
    fill.ZIndex = 14
    round(fill, 3)
    local hit = Instance.new("TextButton", track)
    hit.Size = UDim2.new(1, 0, 0, 16)
    hit.Position = UDim2.new(0, 0, 0.5, -8)
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.ZIndex = 15
    local function setFromX(x)
        local alpha = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
        local v = min + (max - min) * alpha
        if isFloat then v = math.floor(v * 100) / 100 else v = math.floor(v + 0.5) end
        Settings[key] = v
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        val.Text = isFloat and string.format("%.2f", v) or tostring(v)
        if key == "FOVRadius" and fovCircle then
            fovCircle.Size = UDim2.new(0, Settings.FOVRadius * 2, 0, Settings.FOVRadius * 2)
        end
        if key == "FOVThickness" and fovStroke then
            fovStroke.Thickness = Settings.FOVThickness
        end
        if key == "LockTracerThickness" and lockTracer then
            lockTracer.Thickness = Settings.LockTracerThickness
        end
        persist()
    end
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            setFromX(input.Position.X)
            local move, endc
            move = UserInputService.InputChanged:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
                    setFromX(inp.Position.X)
                end
            end)
            endc = UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    move:Disconnect(); endc:Disconnect()
                end
            end)
        end
    end)
end

