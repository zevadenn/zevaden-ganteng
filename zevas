local function realAntiCheatScan()
    local findings = {}
    local patterns = {
        "anticheat", "anti%-cheat", "ac_", "_ac", "battleye", "eac",
        "vanguard", "hyperion", "byfron", "kernel", "inject",
        "detect", "integrity", "validate", "verify", "suspicious",
        "report", "ban", "kick", "punish", "sanction", "monitor",
        "audit", "anomal", "secur", "guard", "shield", "sentinel",
    }
    local function matches(s)
        local low = s:lower()
        for _, pat in ipairs(patterns) do if low:find(pat) then return pat end end
        return nil
    end
    local services = {
        game:GetService("ReplicatedStorage"), game:GetService("ReplicatedFirst"),
        game:GetService("StarterGui"), game:GetService("StarterPlayer"),
        game:GetService("ServerStorage"), game:GetService("ServerScriptService"),
        game:GetService("Chat"), game:GetService("SoundService"),
    }
    for _, svc in ipairs(services) do
        pcall(function()
            for _, obj in ipairs(svc:GetDescendants()) do
                local ok = obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")
                       or obj:IsA("BindableEvent") or obj:IsA("BindableFunction")
                       or obj:IsA("Script") or obj:IsA("LocalScript")
                       or obj:IsA("ModuleScript") or obj:IsA("Folder") or obj:IsA("Actor")
                if ok then
                    local hit = matches(obj.Name)
                    if hit then
                        table.insert(findings, {
                            name = obj.Name, class = obj.ClassName,
                            path = obj:GetFullName(), match = hit,
                        })
                    end
                end
            end
        end)
    end
    pcall(function()
        local ok, attrs = pcall(function() return p:GetAttributes() end)
        if ok and type(attrs) == "table" then
            for k in pairs(attrs) do
                local hit = matches(k)
                if hit then table.insert(findings, {name = k, class = "Attribute", path = "LocalPlayer." .. k, match = hit}) end
            end
        end
    end)
    pcall(function()
        local env = (getgenv and getgenv()) or _G or {}
        for k in pairs(env) do
            if type(k) == "string" and #k < 64 then
                local hit = matches(k)
                if hit and not k:find("^zeva") and not k:find("^__zeva") then
                    table.insert(findings, {name = k, class = "Global", path = "getgenv()", match = hit})
                end
            end
        end
    end)
    return findings, #findings
end

