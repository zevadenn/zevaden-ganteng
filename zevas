    local fpsFrames = 0
    local fpsLast = tick()
    local fpsValue = 0
    local pingValue = 0
    local fpsBoostAccum = 0

    mainLoop = RS.RenderStepped:Connect(function(dt)
        local camPos = c.CFrame.Position
        local screenCenter = c.ViewportSize / 2

        if cfg.FPSOverlay then
            fpsFrames = fpsFrames + 1
            if tick() - fpsLast >= 1 then
                fpsValue = fpsFrames
                fpsFrames = 0
                fpsLast = tick()
                pcall(function()
                    local item = Stats.Network.ServerStatsItem["Data Ping"]
                    if item then pingValue = math.floor(item:GetValue()) end
                end)
            end
        end

        if cfg.FPSBooster then
            fpsBoostAccum = fpsBoostAccum + dt
            if fpsBoostAccum >= 1 then
                fpsBoostAccum = 0
                applyFPSBooster()
            end
        end

        if cfg.FreeCam and fcCFrame then
            local move = Vector3.zero
            if fcKeys.W then move = move + fcCFrame.LookVector end
            if fcKeys.S then move = move - fcCFrame.LookVector end
            if fcKeys.A then move = move - fcCFrame.RightVector end
            if fcKeys.D then move = move + fcCFrame.RightVector end
            if fcKeys.E then move = move + Vector3.yAxis end
            if fcKeys.Q then move = move - Vector3.yAxis end
            if move.Magnitude > 0 then
                fcCFrame = CFrame.new(fcCFrame.Position + move.Unit * cfg.FreeCamSpeed * dt) * (fcCFrame - fcCFrame.Position)
            end
            c.CFrame = fcCFrame
        end

        if cfg.AntiAimEnabled then applyAntiAim() end

        if fC then pcall(function()
            fC.Radius = cfg.FovSize
            fC.Position = c.ViewportSize/2
            fC.Visible = cfg.ShowFov and cfg.FovShape == "Circle"
        end) end
        if fS then pcall(function()
            local r = cfg.FovSize
            local vs = c.ViewportSize
            fS.Position = Vector2.new(vs.X/2 - r, vs.Y/2 - r)
            fS.Size = Vector2.new(r*2, r*2)
            fS.Visible = cfg.ShowFov and cfg.FovShape == "Square"
        end) end
        if fT then pcall(function()
            fT.Radius = cfg.FovSize
            fT.Position = c.ViewportSize/2
            fT.Visible = cfg.ShowFov and cfg.FovShape == "Triangle"
        end) end

        if #crosshairParts > 0 then
            local vs = c.ViewportSize
            local cx, cy = vs.X/2, vs.Y/2
            for _, o in ipairs(crosshairParts) do
                pcall(function()
                    if o.ClassName == "Circle" then o.Position = Vector2.new(cx, cy) end
                end)
            end
        end

        if cfg.Noclip and p.Character then
            for _, pt in pairs(p.Character:GetDescendants()) do
                if pt:IsA("BasePart") then pt.CanCollide = false end
            end
        end

        if cfg.Spin and p.Character and p.Character.PrimaryPart then
            p.Character:SetPrimaryPartCFrame(p.Character.PrimaryPart.CFrame * CFrame.Angles(0, math.rad(cfg.SpinSpeed), 0))
        end

        for _, pl in pairs(P:GetPlayers()) do
            if pl ~= p then
                trackVel(pl)
                local ch = pl.Character
                if ch and ch:FindFirstChild("Humanoid") then
                    local hum = ch.Humanoid
                    local hp = hum.Health
                    if not lastHealth[pl] then lastHealth[pl] = hp end
                    if cfg.Chams and hp < lastHealth[pl] and hp > 0 then pushCham(pl) end
                    if cfg.KillFeed and lastHealth[pl] > 0 and hp <= 0 then
                        pushKillFeed(pl)
                    end
                    lastHealth[pl] = hp
                end
            end
        end
        updateChams()

        for pl, d in pairs(dr) do
            local ch = pl.Character
            if v(pl) then
                local hrp = ch:FindFirstChild("HumanoidRootPart")
                local hum = ch:FindFirstChild("Humanoid")
                if hrp and hum then
                    local ps, on = c:WorldToViewportPoint(hrp.Position)
                    local dist = (camPos - hrp.Position).Magnitude
                    if on and ps.Z > 0 and dist < 600 then
                        local tS = c:WorldToViewportPoint(hrp.Position + Vector3.new(0, 2.5, 0))
                        local bS = c:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                        local ht = math.abs(bS.Y - tS.Y); local wd = ht / 1.6

                        if d.B then
                            if cfg.Box then
                                d.B.Visible, d.B.Size, d.B.Position = true, Vector2.new(wd, ht), Vector2.new(ps.X - wd/2, tS.Y)
                                d.B.Color = cfg.BoxColor
                                d.B.Thickness = cfg.BoxThickness
                                d.B.Filled = cfg.ESPFilled
                            else d.B.Visible = false end
                        end

                        if d.HB and d.HM then
                            if cfg.Health then
                                local bX = ps.X - wd/2 - 6
                                d.HB.Visible, d.HB.From, d.HB.To = true, Vector2.new(bX, tS.Y), Vector2.new(bX, tS.Y + ht)
                                d.HB.Color = cfg.HealthColor
                                d.HB.Thickness = cfg.HealthThickness
                                local ratio = hum.Health / hum.MaxHealth
                                d.HM.Visible, d.HM.From, d.HM.To, d.HM.Color =
                                    true, Vector2.new(bX, tS.Y + ht), Vector2.new(bX, tS.Y + ht - (ht * ratio)),
                                    Color3.fromHSV(ratio * .3, 1, 1)
                                d.HM.Thickness = cfg.HealthThickness
                            else d.HB.Visible, d.HM.Visible = false, false end
                        end

                        if d.D then
                            if cfg.Dist then
                                d.D.Visible, d.D.Text, d.D.Position = true, math.floor(dist).."m", Vector2.new(ps.X, tS.Y + ht + 2)
                                d.D.Color = cfg.DistanceColor
                                d.D.Size = cfg.ESPFontSize
                            else d.D.Visible = false end
                        end

                        if d.T then
                            if cfg.Tracer then
                                d.T.Visible, d.T.From, d.T.To = true, Vector2.new(c.ViewportSize.X/2, 0), Vector2.new(ps.X, ps.Y)
                                d.T.Color = cfg.TracerColor
                                d.T.Thickness = cfg.TracerThickness
                            else d.T.Visible = false end
                        end

                        if d.LT then
                            if cfg.LookTracer and ch:FindFirstChild("Head") then
                                local hp2, onS = c:WorldToViewportPoint(ch.Head.Position)
                                local center = Vector2.new(c.ViewportSize.X/2, c.ViewportSize.Y/2)
                                local dFC = (Vector2.new(hp2.X, hp2.Y) - center).Magnitude
                                if onS and dFC <= cfg.FovSize then
                                    d.LT.Visible = true; d.LT.From = center
                                    d.LT.To = Vector2.new(hp2.X, hp2.Y)
                                    d.LT.Color = cfg.LookTracerColor
                                    d.LT.Thickness = cfg.LookTracerThickness
                                else d.LT.Visible = false end
                            else d.LT.Visible = false end
                        end

                        if cfg.Bone then
                            local li = 1
                            for _, pr in pairs(bPs) do
                                local p1, p2 = ch:FindFirstChild(pr[1]), ch:FindFirstChild(pr[2])
                                if p1 and p2 then
                                    local v1, o1 = c:WorldToViewportPoint(p1.Position)
                                    local v2, o2 = c:WorldToViewportPoint(p2.Position)
                                    if o1 and o2 and d.L[li] then
                                        d.L[li].Visible = true
                                        d.L[li].From = Vector2.new(v1.X, v1.Y)
                                        d.L[li].To   = Vector2.new(v2.X, v2.Y)
                                        d.L[li].Color = cfg.BoneColor
                                        d.L[li].Thickness = cfg.BoneThickness
                                        li = li + 1
                                    end
                                end
                            end
                            for i = li, 30 do if d.L[i] then d.L[i].Visible = false end end
                        else
                            for _, l in pairs(d.L) do if l then l.Visible = false end end
                        end
                    else
                        if d.B then d.B.Visible = false end
                        if d.D then d.D.Visible = false end
                        if d.HB then d.HB.Visible = false end
                        if d.HM then d.HM.Visible = false end
                        if d.T then d.T.Visible = false end
                        if d.LT then d.LT.Visible = false end
                        for _, l in pairs(d.L) do if l then l.Visible = false end end
                    end
                end
            else
                if d.B then d.B.Visible = false end
                if d.D then d.D.Visible = false end
                if d.HB then d.HB.Visible = false end
                if d.HM then d.HM.Visible = false end
                if d.T then d.T.Visible = false end
                if d.LT then d.LT.Visible = false end
                for _, l in pairs(d.L) do if l then l.Visible = false end end
            end
        end

        if cfg.Aim then
            local tg, tgPl, bestScore = nil, nil, math.huge
            local vs = c.ViewportSize
            local cx, cy = vs.X/2, vs.Y/2
            for _, pl in pairs(P:GetPlayers()) do
                if v(pl) and (cfg.TargetAll or cfg.TargetList[pl.Name]) then
                    local pts = {}
                    if cfg.UseNearest then
                        for _, cd in pairs(pl.Character:GetChildren()) do
                            if cd:IsA("BasePart") then table.insert(pts, cd) end
                        end
                    else
                        for pN, ac in pairs(cfg.SelectedParts) do
                            if ac and pl.Character:FindFirstChild(pN) then
                                table.insert(pts, pl.Character[pN])
                            end
                        end
                    end
                    for _, pt in ipairs(pts) do
                        local sP, on = c:WorldToViewportPoint(pt.Position)
                        local mg = (Vector2.new(sP.X, sP.Y) - screenCenter).Magnitude
                        if on and mg < cfg.FovSize and (not cfg.WallCheck or vis(pt)) then
                            local sc = scoreTarget(pl, pt, camPos, Vector2.new(cx, cy))
                            if sc < bestScore then
                                bestScore = sc; tg = pt; tgPl = pl
                            end
                        end
                    end
                end
            end
            if tg and tgPl then
                local aimPos = CalcPred(tgPl, tg)
                if aimPos then
                    local rx, ry = 0, 0
                    if cfg.JitterAim then
                        rx = (math.random() - 0.5) * 2 * cfg.RandOffsetX
                        ry = (math.random() - 0.5) * 2 * cfg.RandOffsetY
                    end
                    aimPos = aimPos + (c.CFrame.RightVector * (cfg.OffsetX + rx)) + (c.CFrame.UpVector * (cfg.OffsetY + ry))
                    currentAimPos = aimPos
                end
            else
                currentAimPos = nil
            end
        else
            currentAimPos = nil
        end

        if cfg.KillStats then
            if not _G.__zeva_killStatsGui then
                local sg = Instance.new("ScreenGui", p.PlayerGui)
                sg.Name = "zeva_ks_" .. tostring(math.random(1e6, 9e6))
                sg.ResetOnSpawn = false; sg.IgnoreGuiInset = true; sg.DisplayOrder = 40
                local lbl = Instance.new("TextLabel", sg)
                lbl.Size = UDim2.new(0, 200, 0, 40)
                lbl.Position = UDim2.new(1, -210, 0, 10)
                lbl.BackgroundColor3 = TH.Bg; lbl.BackgroundTransparency = 0.35
                lbl.TextColor3 = TH.Text; lbl.Font = FONTB; lbl.TextSize = 13
                lbl.BorderSizePixel = 0; lbl.Text = ""
                round(lbl, 8); stroke(lbl, TH.LineSoft, 1, 0.4)
                _G.__zeva_killStatsGui = { sg = sg, lbl = lbl }
            end
            local ks = _G.__zeva_killStatsGui
            ks.lbl.Text = "Hits: " .. killStats.hits
            ks.sg.Enabled = true
        elseif _G.__zeva_killStatsGui then
            _G.__zeva_killStatsGui.sg.Enabled = false
        end

        local nowT = tick()
        for i = #killFeed, 1, -1 do
            if nowT - killFeed[i].born > 4 then table.remove(killFeed, i) end
        end
        if cfg.KillFeed then
            if not _G.__zeva_killFeedGui then
                local sg = Instance.new("ScreenGui", p.PlayerGui)
                sg.Name = "zeva_kf_" .. tostring(math.random(1e6, 9e6))
                sg.ResetOnSpawn = false; sg.IgnoreGuiInset = true; sg.DisplayOrder = 40
                local holder = Instance.new("Frame", sg)
                holder.Size = UDim2.new(0, 260, 0, 200)
                holder.Position = UDim2.new(1, -270, 1, -220)
                holder.BackgroundTransparency = 1
                local lay = Instance.new("UIListLayout", holder)
                lay.SortOrder = Enum.SortOrder.LayoutOrder
                lay.VerticalAlignment = Enum.VerticalAlignment.Bottom
                lay.Padding = UDim.new(0, 4)
                _G.__zeva_killFeedGui = { sg = sg, holder = holder }
            end
            local kf = _G.__zeva_killFeedGui
            for _, ch in ipairs(kf.holder:GetChildren()) do
                if ch:IsA("TextLabel") then ch:Destroy() end
            end
            for i, item in ipairs(killFeed) do
                local lbl = Instance.new("TextLabel", kf.holder)
                lbl.Size = UDim2.new(1, 0, 0, 22)
                lbl.BackgroundColor3 = TH.Bg; lbl.BackgroundTransparency = 0.3
                lbl.TextColor3 = TH.Text; lbl.Font = FONTB; lbl.TextSize = 11
                lbl.Text = "×  " .. item.name
                lbl.BorderSizePixel = 0
                lbl.LayoutOrder = i
                round(lbl, 4)
            end
            kf.sg.Enabled = true
        elseif _G.__zeva_killFeedGui then
            _G.__zeva_killFeedGui.sg.Enabled = false
        end

        if cfg.Radar then
            if not _G.__zeva_radarGui then
                local sg = Instance.new("ScreenGui", p.PlayerGui)
                sg.Name = "zeva_radar_" .. tostring(math.random(1e6, 9e6))
                sg.ResetOnSpawn = false; sg.IgnoreGuiInset = true; sg.DisplayOrder = 40
                local frame = Instance.new("Frame", sg)
                frame.Size = UDim2.new(0, cfg.RadarSize, 0, cfg.RadarSize)
                frame.Position = UDim2.new(0, 20, 0, 100)
                frame.BackgroundColor3 = TH.Bg
                frame.BackgroundTransparency = 0.35
                frame.BorderSizePixel = 0
                frame.ClipsDescendants = true
                round(frame, 8); stroke(frame, TH.LineSoft, 1, 0.4)
                local holder = Instance.new("Frame", frame)
                holder.Size = UDim2.new(1, 0, 1, 0); holder.BackgroundTransparency = 1
                local selfDot = Instance.new("Frame", holder)
                selfDot.Size = UDim2.new(0, 6, 0, 6)
                selfDot.BackgroundColor3 = TH.Accent
                selfDot.BorderSizePixel = 0
                round(selfDot, 3)
                _G.__zeva_radarGui = { sg = sg, frame = frame, holder = holder, selfDot = selfDot, dots = {} }
            end
            local rd = _G.__zeva_radarGui
            if rd.frame.Size.X.Offset ~= cfg.RadarSize then
                rd.frame.Size = UDim2.new(0, cfg.RadarSize, 0, cfg.RadarSize)
            end
            local half = cfg.RadarSize / 2
            local range = cfg.RadarRange

            rd.selfDot.Position = UDim2.new(0, half - 3, 0, half - 3)

            local cpos = c.CFrame.Position
            local look = c.CFrame.LookVector
            local yaw = math.atan2(look.X, look.Z)
            local cosY, sinY = math.cos(yaw), math.sin(yaw)

            local dots = rd.dots
            local idx = 0
            for _, pl in pairs(P:GetPlayers()) do
                if pl ~= p and pl.Character then
                    local hrp = pl.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local rel = hrp.Position - cpos
                        local dx, dz = rel.X, rel.Z
                        local dist = math.sqrt(dx*dx + dz*dz)
                        if dist < range then
                            idx = idx + 1
                            local dot = dots[idx]
                            if not dot or not dot.Parent then
                                dot = Instance.new("Frame", rd.holder)
                                dot.Size = UDim2.new(0, 6, 0, 6)
                                dot.BackgroundColor3 = TH.Danger
                                dot.BorderSizePixel = 0
                                round(dot, 3)
                                dots[idx] = dot
                            end
                            local rx = dx * cosY - dz * sinY
                            local rz = dx * sinY + dz * cosY
                            local sx = half + (rx / range) * half
                            local sy = half - (rz / range) * half
                            dot.Position = UDim2.new(0, sx - 3, 0, sy - 3)
                            dot.Visible = true
                        end
                    end
                end
            end
            for i = idx + 1, #dots do
                if dots[i] then dots[i].Visible = false end
            end
            rd.sg.Enabled = true
        elseif _G.__zeva_radarGui then
            _G.__zeva_radarGui.sg.Enabled = false
        end

        if cfg.FPSOverlay then
            if not _G.__zeva_fpsGui then
                local sg = Instance.new("ScreenGui", p.PlayerGui)
                sg.Name = "zeva_fps_" .. tostring(math.random(1e6, 9e6))
                sg.ResetOnSpawn = false; sg.IgnoreGuiInset = true; sg.DisplayOrder = 40
                local lbl = Instance.new("TextLabel", sg)
                lbl.Size = UDim2.new(0, 200, 0, 24)
                lbl.Position = UDim2.new(1, -210, 0, 10)
                lbl.BackgroundColor3 = TH.Bg; lbl.BackgroundTransparency = 0.4
                lbl.TextColor3 = TH.Accent; lbl.Font = FONTB; lbl.TextSize = 12
                lbl.BorderSizePixel = 0; lbl.Text = ""
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                local pp = Instance.new("UIPadding", lbl)
                pp.PaddingLeft = UDim.new(0, 8)
                round(lbl, 6); stroke(lbl, TH.LineSoft, 1, 0.4)
                _G.__zeva_fpsGui = { sg = sg, lbl = lbl }
            end
            local fg = _G.__zeva_fpsGui
            fg.lbl.Text = "FPS: " .. fpsValue .. "   Ping: " .. pingValue .. "ms"
            fg.sg.Enabled = true
        elseif _G.__zeva_fpsGui then
            _G.__zeva_fpsGui.sg.Enabled = false
        end
    end)

    task.spawn(function()
        local lastT = 0; local lastHit = 0
        while g and g.Parent do
            if cfg.Trig then
                local now = tick()
                if now - lastT > cfg.Dly then
                    local screenCenter = c.ViewportSize / 2
                    local ray = c:ViewportPointToRay(screenCenter.X, screenCenter.Y)
                    local rp = RaycastParams.new()
                    rp.FilterDescendantsInstances = {p.Character, c}
                    rp.FilterType = Enum.RaycastFilterType.Blacklist
                    local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, rp)
                    if result and result.Instance then
                        local model = result.Instance:FindFirstAncestorOfClass("Model")
                        local hitPl = model and P:GetPlayerFromCharacter(model)
                        if hitPl and v(hitPl) then
                            local hitDist = (result.Position - ray.Origin).Magnitude
                            if hitDist <= cfg.MaxTriggerDist and (not cfg.WallCheck or vis(result.Instance)) then
                                pcall(function()
                                    VIM:SendMouseButtonEvent(screenCenter.X, screenCenter.Y, 0, true, game, 1)
                                    RS.Heartbeat:Wait()
                                    VIM:SendMouseButtonEvent(screenCenter.X, screenCenter.Y, 0, false, game, 1)
                                end)
                                lastT = tick() + math.random() * cfg.RandDelay
                                killStats.hits = killStats.hits + 1
                                if cfg.HitSound and hitSound and tick() - lastHit > 0.15 then
                                    hitSound:Play(); lastHit = tick()
                                end
                            end
                        end
                    end
                end
            end
            RS.Heartbeat:Wait()
        end
    end)

    P.PlayerRemoving:Connect(function(pl)
        local d = dr[pl]
        if d then
            pcall(function() if d.B then d.B:Remove() end end)
            pcall(function() if d.HB then d.HB:Remove() end end)
            pcall(function() if d.HM then d.HM:Remove() end end)
            pcall(function() if d.D then d.D:Remove() end end)
            pcall(function() if d.T then d.T:Remove() end end)
            pcall(function() if d.LT then d.LT:Remove() end end)
            for _, l in pairs(d.L) do pcall(function() if l then l:Remove() end end) end
            dr[pl] = nil
        end
        local hc = hitChams[pl]
        if hc then pcall(function() hc.sq:Remove() end); hitChams[pl] = nil end
        lastHealth[pl] = nil; velHist[pl] = nil
    end)
end

buildSelector()
