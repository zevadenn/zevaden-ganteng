    local function stripPerf(obj)
        if not obj then return end
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke")
           or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("Explosion")
           or obj:IsA("Beam") then
            _saveSet(obj, "Enabled", false)
        elseif obj:IsA("PostEffect") then
            _saveSet(obj, "Enabled", false)
        elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
            if obj.Enabled then _saveSet(obj, "Enabled", false) end
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            if obj.Transparency < 1 then _saveSet(obj, "Transparency", 1) end
        elseif obj:IsA("BasePart") then
            if obj.CastShadow then _saveSet(obj, "CastShadow", false) end
        end
    end

    local function applyFPSBooster()
        if fpsBoosted then return end
