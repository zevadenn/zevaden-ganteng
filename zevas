local KO_MARKERS = {
    {"BodyEffects","K.O"},{"BodyEffects","KO"},{"BodyEffects","Knocked"},
    {"BodyEffects","Downed"},{"BodyEffects","Dead"},{"BodyEffects","Ragdoll"},
    {"Knock",false},{"Knockout",false},{"Downed",false},{"Ragdoll",false},{"KO",false},{"K.O",false},
}
local KO_ATTRS = {"K.O","KO","Knocked","IsKnocked","Downed","IsDowned","Dead","IsDead","Alive","Ragdolled","IsRagdolled"}

local function isKOorDead(pl)
    if not pl or pl == LocalPlayer then return true end
    local ch = pl.Character; if not ch then return true end
    local hum = ch:FindFirstChildOfClass("Humanoid"); if not hum or hum.Health <= 0 then return true end
    local okS, state = pcall(function() return hum:GetState() end)
    if okS and (state == Enum.HumanoidStateType.Dead or state == Enum.HumanoidStateType.Physics) then return true end
    if hum.PlatformStand then return true end
    for _, e in ipairs(KO_MARKERS) do
        local cont = ch:FindFirstChild(e[1])
        if cont then
            local t = e[2] and cont:FindFirstChild(e[2]) or cont
            if t then
                if t:IsA("BoolValue") and t.Value then return true end
                if t:IsA("NumberValue") and t.Value > 0 then return true end
                if t:IsA("StringValue") and t.Value ~= "" then return true end
            end
        end
    end
    for _, a in ipairs(KO_ATTRS) do
        local ok, v = pcall(function() return ch:GetAttribute(a) end)
        if ok and v ~= nil then
            if a == "Alive" then if v == false then return true end
            elseif v == true or v == "true" then return true end
        end
    end
    local hrp = ch:FindFirstChild("HumanoidRootPart")
    if hrp then
        local r = hrp:FindFirstChild("RagdollConstraints")
        if r and #r:GetChildren() > 0 then return true end
    end
    return false
end

local koCache = {}
local function isKOorDead_cached(pl)
    local ch = pl.Character; if not ch then return true end
    local e = koCache[ch]; local now = tick()
    if e and now < e.expires then return e.dead end
    local d = isKOorDead(pl)
    koCache[ch] = {dead = d, expires = now + 0.15}
