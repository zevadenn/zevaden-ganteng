        for i = 1, #sweep do stripPerf(sweep[i]) end
        sweep = nil
        for _, o in ipairs(L:GetChildren()) do
            if o:IsA("PostEffect") then _saveSet(o, "Enabled", false) end
            if o:IsA("Atmosphere") then _saveSet(o, "Density", 0) end
            if o:IsA("Clouds") then _saveSet(o, "Enabled", false) end
        end
        _saveSet(L, "GlobalShadows", false)
        _saveSet(L, "FogEnd", 100000)
        _saveSet(L, "ShadowSoftness", 0)
        _saveSet(L, "EnvironmentDiffuseScale", 0)
        _saveSet(L, "EnvironmentSpecularScale", 0)
        _saveSet(L, "Brightness", 3)
        _saveSet(L, "GlobalWind", Vector3.zero)
        local terr = workspace:FindFirstChildOfClass("Terrain")
        if terr then
            _saveSet(terr, "WaterWaveSize", 0)
            _saveSet(terr, "WaterTransparency", 1)
            _saveSet(terr, "WaterReflectance", 0)
        end
        fpsConns = {
            ws = workspace.DescendantAdded:Connect(stripPerf),
            light = L.ChildAdded:Connect(function(o)
