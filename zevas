    -- ============================================
    local execName, execCaps = fingerprintExecutor()
    local acFindings, acCount, acRaw = realAntiCheatScan()

    -- auto-firewall: add every RemoteEvent/RemoteFunction finding
    local fwActive = installFirewall()
    local blockedCount = 0
    for _, obj in ipairs(acRaw or {}) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            PROTECTED_REMOTES[obj] = true
            blockedCount = blockedCount + 1
        end
    end

    local acStatusText, acStatusColor
    if acCount == 0 then
        acStatusText = "clean"
        acStatusColor = TERM.Green
    elseif fwActive then
        acStatusText = tostring(blockedCount) .. " blocked"
        acStatusColor = TERM.Green
    else
        acStatusText = tostring(acCount) .. " found — firewall offline"
        acStatusColor = TERM.Red
    end

    local capsPreview = #execCaps > 0
        and (execCaps[1] .. (execCaps[2] and ", " .. execCaps[2] or "") .. (#execCaps > 2 and ", +" .. (#execCaps - 2) or ""))
        or "none"

    local remoteCount = 0
    pcall(function()
        for _, o in ipairs(ReplicatedStorage:GetDescendants()) do
            if o:IsA("RemoteEvent") or o:IsA("RemoteFunction") then
                remoteCount = remoteCount + 1
            end
        end
    end)

    -- ============================================
    -- STEPS
    -- ============================================
    local steps = {
        { "[>] establishing secure tunnel ............ ok",           TERM.Amber, "handshake",    0.35 },
        { "[>] fingerprinting executor ............... " .. execName, TERM.Amber, "executor",     0.35 },
        { "[>]   capability check .................... " .. capsPreview, TERM.Dim, "capabilities", 0.3 },
        { "[>] mounting /dev/zeva ................... ok",           TERM.Amber, "mounting fs",  0.25 },
        { "[>] hashing game files ................... ",              TERM.Amber, "hashing",      0.55 },
        { "[>]   Game.PlaceId    = " .. tostring(game.PlaceId),       TERM.Dim,   "hashing",      0.15 },
        { "[>]   Game.JobId      = " .. tostring(game.JobId):sub(1, 12) .. "..", TERM.Dim, "hashing", 0.15 },
        { "[>]   Players.Count   = " .. tostring(#P:GetPlayers()),    TERM.Dim,   "hashing",      0.15 },
        { "[>] verifying asset integrity ............ ok",           TERM.Amber, "assets",       0.35 },
        { "[>] enumerating remote events ........... " .. tostring(remoteCount) .. " found", TERM.Amber, "remotes", 0.35 },
        { "[>] scanning for anti-cheat hooks ....... ",              TERM.Amber, "anti-cheat",   0.8 },
        { "[>]   result ............................. " .. acStatusText, acStatusColor, "anti-cheat", 0.4 },
    }

    if acCount > 0 then
        local shown = math.min(acCount, 3)
        for i = 1, shown do
            local f = acFindings[i]
            local label = "  > " .. f.class .. " '" .. f.name .. "'"
            if #label > 46 then label = label:sub(1, 43) .. "..." end
            local isRemote = (f.class == "RemoteEvent" or f.class == "RemoteFunction")
            local tag = isRemote and "[×] " or "[!] "
            local col = isRemote and TERM.Red or TERM.Dim
            table.insert(steps, { tag .. label, col, "firewall", 0.22 })
        end
        if acCount > shown then
            table.insert(steps, { "[×]   + " .. tostring(acCount - shown) .. " more", TERM.Dim, "firewall", 0.2 })
        end
        if blockedCount > 0 and fwActive then
            table.insert(steps, {
                "[>] blocking " .. tostring(blockedCount) .. " remote" .. (blockedCount == 1 and "" or "s") .. " .......... ok",
                TERM.Green, "firewall", 0.35
            })
        end
    end

    local tail = {
        { "[>] checking account status ............. ok",        TERM.Amber, "account",   0.3 },
        { "[>] loading zeva core modules ........... ok",        TERM.Amber, "modules",   0.4 },
        { "[>] applying config ..................... ok",        TERM.Amber, "config",    0.35 },
        { "[>] injecting runtime ................... ok",        TERM.Green, "injecting", 0.35 },
        { "[>] initializing gui .................... ok",        TERM.Hi,    "gui",       0.3 },
        { "[*] access granted — welcome, " .. p.DisplayName,     TERM.Green, "done",      0.45 },
    }
    for _, st in ipairs(tail) do table.insert(steps, st) end

    task.spawn(function()
        local total = #steps
        for i, step in ipairs(steps) do
            addLine(step[1], step[2])
            status.Text = step[3]
            local frac = i / total
            tw(barFill, step[4], {Size = UDim2.new(frac, 0, 1, 0)})
            pct.Text = math.floor(frac * 100) .. "%"
            task.wait(step[4])
        end
        pct.Text = "100%"
        s.Color = TERM.Green
        task.wait(0.5)
        sG:Destroy()
        task.wait(0.1)
        if onDone then onDone() end
    end)
end

