                kErr.Text = "[err] key bound to another user"
                kBox.Text = ""
                tw(s, EASE.fast, {Color = TERM.Red})
                task.delay(0.5, function() pcall(function() tw(s, EASE.fast, {Color = TERM.Line}) end) end)
                pcall(function() kBox:CaptureFocus() end)
                return
            end
        end

        kErr.TextColor3 = TERM.Green
        kErr.Text = "[ok]  access granted -- " .. p.Name
        tw(s, EASE.fast, {Color = TERM.Green})
        _G.__zeva_sessionKey = entered
        _G.__zeva_sessionPlatform = currentPlatform
        task.wait(0.45)
        kG:Destroy()
        buildScanScreen(function() StartScript(currentPlatform) end)
    end

    kSubmit.MouseButton1Click:Connect(trySubmit)
    kBox.FocusLost:Connect(function(e) if e then trySubmit() end end)
    pcall(function() kBox:CaptureFocus() end)
