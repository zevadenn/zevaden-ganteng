local visCheckParams = RaycastParams.new()
visCheckParams.FilterType = Enum.RaycastFilterType.Blacklist

local function isVisible(targetCharacter)
    if not targetCharacter then return false end
    local targetHRP = targetCharacter:FindFirstChild("HumanoidRootPart")
    if not targetHRP then return false end
    local localChar = player.Character
    local localHRP = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if not localHRP then return false end
    local origin = targetHRP.Position
    local direction = localHRP.Position - origin
    visCheckParams.FilterDescendantsInstances = {player.Character, targetCharacter}
    local result = workspace:Raycast(origin, direction, visCheckParams)
    return result == nil
end

local function isKnocked(char)
    if not char then return false end
    local be = char:FindFirstChild("BodyEffects")
    if be then
        for _, name in ipairs({"K.O", "KO", "Knocked", "Downed"}) do
            local v = be:FindFirstChild(name)
            if v and v:IsA("BoolValue") and v.Value then return true end
        end
    end
    for _, name in ipairs({"K.O", "KO", "Knocked", "IsKnocked", "Downed", "IsDowned"}) do
        local v = char:FindFirstChild(name)
        if v and v:IsA("BoolValue") and v.Value then return true end
        local attr = char:GetAttribute(name)
        if attr == true then return true end
    end
    return false
end

local function isValidTarget(plr)
    if not plr or plr == player then return false end
    if not plr.Character then return false end
    if Settings.IgnoreTargets and #Settings.IgnoreTargets > 0 then
        for _, name in ipairs(Settings.IgnoreTargets) do
            if plr.Name == name then return false end
        end
    end
    if Settings.Whitelist and #Settings.Whitelist > 0 then
        for _, name in ipairs(Settings.Whitelist) do
            if plr.Name == name then return false end
        end
    end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
    if not hum or hum.Health <= 0 or not hrp then return false end
    if Settings.TeamCheck and player.Team and plr.Team == player.Team then return false end
    if plr.Team and Settings.TargetTeams and not Settings.TargetTeams[plr.Team.Name] then return false end
    if Settings.SilentAimRange then
        local localRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if localRoot then
            if (hrp.Position - localRoot.Position).Magnitude > Settings.SilentAimRange then return false end
        end
    end
    if Settings.VisibleCheck and not isVisible(plr.Character) then return false end
    if Settings.ForceFieldCheck and plr.Character:FindFirstChildOfClass("ForceField") then return false end
    if Settings.KOCheck and isKnocked(plr.Character) then return false end
    return true
end

local function isTargetListed(plr)
    if not Settings.TargetListEnabled or #Settings.TargetOnPlayer == 0 then return true end
    for _, name in ipairs(Settings.TargetOnPlayer) do
        if name == plr.Name then return true end
    end
    return false
end

