        local snap = bhCache[part]
        if not snap then return end
        for _, ch in ipairs(part:GetDescendants()) do
            local saved = snap.children[ch]
            if not saved then saved = {}; snap.children[ch] = saved end
            if ch:IsA("Decal") or ch:IsA("Texture") or ch:IsA("SurfaceAppearance") then
                if saved.Transparency == nil then saved.Transparency = ch.Transparency end
                ch.Transparency = 1
            elseif ch:IsA("SpecialMesh") or ch:IsA("BlockMesh") or ch:IsA("CylinderMesh")
                or ch:IsA("SphereMesh") or ch:IsA("FileMesh") or ch:IsA("BevelMesh") then
                if saved.Scale == nil then saved.Scale = ch.Scale end
                ch.Scale = Vector3.zero
            elseif ch:IsA("ParticleEmitter") or ch:IsA("Trail") or ch:IsA("Beam")
                or ch:IsA("Fire") or ch:IsA("Smoke") or ch:IsA("Sparkles") then
                if saved.Enabled == nil then saved.Enabled = ch.Enabled end
                ch.Enabled = false
            elseif ch:IsA("BillboardGui") or ch:IsA("SurfaceGui") then
                if saved.Enabled == nil then saved.Enabled = ch.Enabled end
                ch.Enabled = false
            elseif ch:IsA("BasePart") then
                if saved.LocalTransparencyModifier == nil then
                    saved.LocalTransparencyModifier = ch.LocalTransparencyModifier
                    saved.Transparency2 = ch.Transparency
                end
                ch.LocalTransparencyModifier = 1; ch.Transparency = 1
                for _, cc in ipairs(ch:GetDescendants()) do
                    if cc:IsA("Decal") or cc:IsA("Texture") then
                        local sc = snap.children[cc]; if not sc then sc = {}; snap.children[cc] = sc end
                        if sc.Transparency == nil then sc.Transparency = cc.Transparency end
                        cc.Transparency = 1
                    end
                end
            end
        end
