-- ============================================================
-- FIREWALL
-- Shared protected set. Scan feeds into this at runtime.
-- Any RemoteEvent/RemoteFunction keyed here has its FireServer
-- and InvokeServer calls silently dropped.
-- ============================================================
local PROTECTED_REMOTES = {}
local FIREWALL_ACTIVE = false

local function installFirewall()
    if FIREWALL_ACTIVE then return true end
    if not (getrawmetatable and setreadonly and newcclosure and getnamecallmethod) then
        return false
    end
    local mt = getrawmetatable(game)
    if not mt then return false end
    local ok = pcall(function()
        local oldNamecall = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" or method == "InvokeServer" then
                if PROTECTED_REMOTES[self] then return nil end
            end
            return oldNamecall(self, ...)
        end)
        setreadonly(mt, true)
    end)
    FIREWALL_ACTIVE = ok
    return ok
end

