        b.AutoButtonColor, b.BorderSizePixel = false, 0
        round(b, 6); stroke(b, TH.LineSoft, 1, 0.4); regAccent(b, "TextColor3")
        local listening = false
        b.MouseButton1Click:Connect(function()
            if listening then return end
            listening = true; b.Text = "press a key..."
            task.wait(0.15)
            local conn
            conn = U.InputBegan:Connect(function(input, gpe)
                if gpe then return end
                if not listening then if conn then conn:Disconnect() end; return end
                local isKey = input.UserInputType == Enum.UserInputType.Keyboard
                local isL = input.UserInputType == UIT_M1
                local isR = input.UserInputType == Enum.UserInputType.MouseButton2
                local isM = input.UserInputType == Enum.UserInputType.MouseButton3
                if isKey or isL or isR or isM then
                    if conn then conn:Disconnect() end
                    listening = false
                    local key
                    if isKey then key = input.KeyCode
                    elseif isL then key = UIT_M1
                    elseif isR then key = Enum.UserInputType.MouseButton2
                    else key = Enum.UserInputType.MouseButton3 end
                    if key == Enum.KeyCode.Escape then b.Text = keyName(getKey())
                    elseif key == Enum.KeyCode.Backspace then setKey(nil); b.Text = "None"
                    else setKey(key); b.Text = keyName(key) end
                end
            end)
            task.delay(5, function() if listening then if conn then conn:Disconnect() end; listening = false; b.Text = keyName(getKey()) end end)
        end)
        regRefresh(cfgKey, function() b.Text = keyName(cfg[cfgKey]) end)
        regFeature(label, BUILD_PAGE, r)
        return b
    end

