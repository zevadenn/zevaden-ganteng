local function fingerprintExecutor()
    local name = "unknown"
    pcall(function()
        if identifyexecutor then name = tostring(identifyexecutor()) end
    end)
    pcall(function()
        if (name == "unknown" or name == "" or name == "nil") and getexecutorname then
            name = tostring(getexecutorname())
