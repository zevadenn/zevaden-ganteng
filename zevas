                if ch then
                    local hrp = ch:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local ps, on = c:WorldToViewportPoint(hrp.Position)
                        local tS = c:WorldToViewportPoint(hrp.Position + V3_HEAD)
                        local bS = c:WorldToViewportPoint(hrp.Position - V3_FEET)
                        local h = math.abs(bS.Y - tS.Y); local w = h / 1.6
                        data.sq.Size = Vector2.new(w, h)
                        data.sq.Position = Vector2.new(ps.X - w/2, tS.Y)
                        data.sq.Visible = on and ps.Z > 0
                    else
