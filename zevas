local function ripple(parent, x, y)
    pcall(function()
        local r = Instance.new("Frame", parent)
        r.AnchorPoint = Vector2.new(0.5, 0.5)
        r.BackgroundColor3 = TH.Accent
        r.BackgroundTransparency = 0.75
