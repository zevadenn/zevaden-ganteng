    local velHist = {}
    local function trackVel(pl)
        local ch = pl.Character
        if not ch then return end
        local hrp = ch:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local v3 = hrp.AssemblyLinearVelocity
        local h = velHist[pl]
        if not h then velHist[pl] = {v3, v3, v3}
        else h[1], h[2], h[3] = h[2], h[3], v3 end
    end
    local function getAvgVel(pl)
        local h = velHist[pl]
        if not h then return Vector3.new(0,0,0) end
        return (h[1] + h[2] + h[3]) / 3
    end

