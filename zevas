local function pickFakeAim()
    local yaw, pitch
    if currentTarget and currentTarget.Parent then
        local char = player.Character
        local head = char and char:FindFirstChild("Head")
        if head then
            local toTarget = currentTarget.Position - head.Position
            local baseYaw = math.atan2(toTarget.X, toTarget.Z)
            yaw = baseYaw + math.pi + math.rad(math.random(-70, 70))
            yaw = math.atan2(math.sin(yaw), math.cos(yaw))
        else
            yaw = math.rad(math.random(-180, 180))
        end
        pitch = math.rad(math.random(-30, 30))
    else
        yaw = math.rad(math.random(-180, 180))
        pitch = math.rad(math.random(-30, 30))
    end
    antiAim.targetYaw = yaw
    antiAim.targetPitch = pitch
    antiAim.lastPick = tick()
end
