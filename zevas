    local function keybind(parent, label, cfgKey, getKey, setKey, pcOnly)
        if pcOnly and plf ~= "PC" then return end
        local r = row(parent, 28)
        local lbl = Instance.new("TextLabel", r)
        lbl.Size = UDim2.new(0.5, 0, 1, 0); lbl.BackgroundTransparency = 1
        lbl.Text = label; lbl.TextColor3 = TH.Text; lbl.Font = FONT; lbl.TextSize = 12
        lbl.TextXAlignment = Enum.TextXAlignment.Left

        local b = Instance.new("TextButton", r)
        b.Size = UDim2.new(0.5, -10, 1, 0); b.Position = UDim2.new(0.5, 0, 0, 0)
        b.BackgroundColor3 = TH.Panel2; b.Text = keyName(getKey())
        b.TextColor3 = TH.Accent; b.Font = FONTB; b.TextSize = 11
        b.AutoButtonColor = false; b.BorderSizePixel = 0
        round(b, 6); stroke(b, TH.LineSoft, 1, 0.4)
        regAccent(b, "TextColor3")

        local listening = false
        b.MouseButton1Click:Connect(function()
            if listening then return end
            listening = true
            b.Text = "press a key..."
            task.wait(0.15)
            local conn
            conn = U.InputBegan:Connect(function(input, gpe)
                if not listening then
                    if conn then conn:Disconnect() end
                    return
                end
                local isKey = (input.UserInputType == Enum.UserInputType.Keyboard)
                local isLeftMouse = (input.UserInputType == Enum.UserInputType.MouseButton1)
                local isRightMouse = (input.UserInputType == Enum.UserInputType.MouseButton2)
                local isMidMouse = (input.UserInputType == Enum.UserInputType.MouseButton3)
                if isKey or isLeftMouse or isRightMouse or isMidMouse then
                    if conn then conn:Disconnect() end
                    listening = false
                    local key
                    if isKey then key = input.KeyCode
                    elseif isLeftMouse then key = Enum.UserInputType.MouseButton1
                    elseif isRightMouse then key = Enum.UserInputType.MouseButton2
                    else key = Enum.UserInputType.MouseButton3 end
                    if key == Enum.KeyCode.Escape then
                        b.Text = keyName(getKey())
                    elseif key == Enum.KeyCode.Backspace then
                        setKey(nil); b.Text = "None"
                    else
                        setKey(key); b.Text = keyName(key)
                    end
                end
            end)
            task.delay(5, function()
                if listening then
                    if conn then conn:Disconnect() end
                    listening = false
                    b.Text = keyName(getKey())
                end
            end)
        end)

        regRefresh(cfgKey, function() b.Text = keyName(cfg[cfgKey]) end)
        regFeature(label, BUILD_PAGE, r)
        return b
    end

