    local function keybind(parent, label, cfgKey, getKey, setKey, pcOnly)
        if pcOnly and plf ~= "PC" then return end
        local r = row(parent, 28)
        local lbl = Instance.new("TextLabel", r)
        lbl.Size, lbl.BackgroundTransparency, lbl.Text, lbl.TextColor3, lbl.Font, lbl.TextSize =
            UDim2.new(0.5,0,1,0), 1, label, TH.Text, FONT, 12
