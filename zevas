        local vs = c.ViewportSize; local cx, cy = vs.X/2, vs.Y/2
        local col, th, s, gap = cfg.CrosshairColor, cfg.CrosshairThickness, cfg.CrosshairSize, cfg.CrosshairGap
        local function line(x1,y1,x2,y2)
            local l; pcall(function() l = Drawing.new("Line") end); if not l then return end
            l.From, l.To, l.Color, l.Thickness, l.Transparency, l.Visible =
                Vector2.new(cx+x1,cy+y1), Vector2.new(cx+x2,cy+y2), col, th, 1, true
            table.insert(crosshairParts, l)
        end
        local function dot(r)
            local cD; pcall(function() cD = Drawing.new("Circle") end); if not cD then return end
            cD.Position, cD.Radius, cD.NumSides, cD.Filled, cD.Color, cD.Transparency, cD.Visible =
                Vector2.new(cx,cy), r, 32, true, col, 1, true
            table.insert(crosshairParts, cD)
        end
        local function ring(r)
            local cD; pcall(function() cD = Drawing.new("Circle") end); if not cD then return end
            cD.Position, cD.Radius, cD.NumSides, cD.Filled, cD.Color, cD.Thickness, cD.Transparency, cD.Visible =
                Vector2.new(cx,cy), r, 48, false, col, th, 1, true
            table.insert(crosshairParts, cD)
        end
        if cfg.CrosshairStyle == "Cross" then
            line(-s,0,-gap,0); line(gap,0,s,0); line(0,-s,0,-gap); line(0,gap,0,s)
        elseif cfg.CrosshairStyle == "Dot" then dot(math.max(1, th))
        elseif cfg.CrosshairStyle == "Circle" then ring(s)
        elseif cfg.CrosshairStyle == "T" then line(-s,0,s,0); line(0,0,0,s) end
    end
