            tw(s, EASE.fast, {Color = TERM.Red})
            for _, dx in ipairs({-8, 8, -5, 5, -3, 3, 0}) do
                tw(outer, 0.04, {Position = UDim2.new(0.5, -220 + dx, 0.5, -120)})
                task.wait(0.04)
            end
            tw(s, EASE.fast, {Color = TERM.Line})
            pcall(function() kBox:CaptureFocus() end)
            return
        end

        if #allowed > 0 then
            local myName = string.lower(p.Name)
            local ok = false
            for _, allowedName in ipairs(allowed) do
                if string.lower(allowedName) == myName then ok = true; break end
            end
            if not ok then
