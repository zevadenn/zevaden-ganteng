    local function CalcPred(pl, tgt)
        if not tgt then return nil end
        local vel = getAvgVel(pl)
        local pos = tgt.Position
        if not cfg.AutoPred then return pos + vel * cfg.Pred end
        local pingSec = 0
        pcall(function()
            local it = Stats.Network.ServerStatsItem["Data Ping"]
            if it then pingSec = it:GetValue() * 0.001 end
        end)
        local accel = getAvgAccel(pl)
        local dist = (pos - c.CFrame.Position).Magnitude
        local leadTime = cfg.Pred * cfg.PredScale + pingSec * 0.5 + math.min(dist / 2000, 0.15)
        return pos + vel * leadTime + 0.5 * accel * leadTime * leadTime
    end

