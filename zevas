    local function applyAntiAim(dt)
        local char = p.Character; if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
        local neck = char:FindFirstChild("Neck", true)
        if neck and neck:IsA("Motor6D") then
            neck.C0 = CFrame.new(0,1,0) * CFrame.Angles(-math.pi/2 + math.rad(cfg.AntiAimPitch), math.pi, 0)
        end
        local yaw
        if cfg.AntiAimMode == "Static" then yaw = cfg.AntiAimYaw
        elseif cfg.AntiAimMode == "Jitter" then yaw = cfg.AntiAimYaw + math.random(-45,45)
        elseif cfg.AntiAimMode == "Spin" then
            aaYawAccum = (aaYawAccum + cfg.AntiAimSpinSpeed * dt * 60) % 360
            yaw = aaYawAccum
        else yaw = cfg.AntiAimYaw end
        local look = hrp.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude < 0.01 then flat = Vector3.new(0,0,1) end
        flat = flat.Unit
        local newLook = CFrame.Angles(0, math.rad(yaw), 0) * flat
        hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + newLook)
    end
    local function restoreAntiAim()
        aaYawAccum = 0
